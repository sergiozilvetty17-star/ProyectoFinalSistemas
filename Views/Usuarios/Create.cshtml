@model EcommerceApp.Models.UsuarioCreateViewModel

@{
    ViewData["Title"] = "Nuevo usuario";

    var carreras = ViewBag.Carreras as List<EcommerceApp.Models.Carrera>
        ?? new List<EcommerceApp.Models.Carrera>();
}

<div class="page-shell">

    <section class="page-hero">

        <div>

            <div class="eyebrow">
                <span class="eyebrow-dot"></span>
                ADMINISTRACIÓN · USUARIOS
            </div>

            <h1>
                Nuevo usuario
            </h1>

            <p>
                Registra una nueva cuenta de estudiante o docente
                y configura sus datos académicos y de acceso.
            </p>

        </div>

        <div class="hero-actions">

            <a asp-action="Index"
               class="btn btn-outline-secondary">

                <svg class="button-icon"
                     viewBox="0 0 24 24"
                     aria-hidden="true">
                    <path d="M19 12H5" />
                    <path d="m12 19-7-7 7-7" />
                </svg>

                Volver a usuarios

            </a>

        </div>

    </section>


    <div class="form-layout-admin">

        <main class="form-panel">

            <div class="form-panel-header">

                <div class="form-panel-icon primary">

                    <svg viewBox="0 0 24 24"
                         aria-hidden="true">
                        <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                        <circle cx="9" cy="7" r="4" />
                        <path d="M19 8v6" />
                        <path d="M22 11h-6" />
                    </svg>

                </div>

                <div>
                    <span class="section-kicker">
                        CUENTA
                    </span>

                    <h2>
                        Datos del usuario
                    </h2>

                    <p>
                        Completa la información necesaria para crear la cuenta.
                    </p>
                </div>

            </div>


            <div class="form-panel-body">

                <form asp-action="Create"
                      method="post">

                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly"
                         class="validation-summary">
                    </div>


                    <!-- DATOS PERSONALES -->

                    <div class="form-section">

                        <div class="form-section-heading">

                            <span class="form-section-number">
                                01
                            </span>

                            <div>
                                <h3>Datos personales</h3>
                                <p>Información básica del usuario.</p>
                            </div>

                        </div>


                        <div class="row g-3">

                            <div class="col-md-4">
                                <label asp-for="Nombres"
                                       class="form-label">
                                </label>

                                <input asp-for="Nombres"
                                       class="form-control"
                                       placeholder="Ej. Sergio Andre" />

                                <span asp-validation-for="Nombres"
                                      class="field-validation">
                                </span>
                            </div>


                            <div class="col-md-4">
                                <label asp-for="ApellidoPaterno"
                                       class="form-label">
                                </label>

                                <input asp-for="ApellidoPaterno"
                                       class="form-control"
                                       placeholder="Apellido paterno" />

                                <span asp-validation-for="ApellidoPaterno"
                                      class="field-validation">
                                </span>
                            </div>


                            <div class="col-md-4">
                                <label asp-for="ApellidoMaterno"
                                       class="form-label">
                                </label>

                                <input asp-for="ApellidoMaterno"
                                       class="form-control"
                                       placeholder="Apellido materno" />
                            </div>


                            <div class="col-md-6">
                                <label asp-for="CedulaIdentidad"
                                       class="form-label">
                                </label>

                                <input asp-for="CedulaIdentidad"
                                       class="form-control"
                                       placeholder="Ej. 12345678" />

                                <span asp-validation-for="CedulaIdentidad"
                                      class="field-validation">
                                </span>
                            </div>


                            <div class="col-md-6">
                                <label asp-for="Telefono"
                                       class="form-label">
                                </label>

                                <input asp-for="Telefono"
                                       class="form-control"
                                       placeholder="Opcional" />
                            </div>


                            <div class="col-12">

                                <label asp-for="Email"
                                       class="form-label">
                                </label>

                                <input asp-for="Email"
                                       class="form-control"
                                       type="email"
                                       placeholder="correo@ejemplo.com" />

                                <span asp-validation-for="Email"
                                      class="field-validation">
                                </span>

                            </div>

                        </div>

                    </div>


                    <!-- DATOS ACADÉMICOS -->

                    <div class="form-section">

                        <div class="form-section-heading">

                            <span class="form-section-number">
                                02
                            </span>

                            <div>
                                <h3>Datos académicos</h3>
                                <p>Define el rol y la información correspondiente.</p>
                            </div>

                        </div>


                        <div class="row g-3">

                            <div class="col-md-6">

                                <label asp-for="Rol"
                                       class="form-label">
                                </label>

                                <select asp-for="Rol"
                                        class="form-select"
                                        id="rol">

                                    <option value="">
                                        Seleccione un rol
                                    </option>

                                    <option value="Estudiante">
                                        Estudiante
                                    </option>

                                    <option value="Docente">
                                        Docente
                                    </option>

                                </select>

                                <span asp-validation-for="Rol"
                                      class="field-validation">
                                </span>

                            </div>


                            <div class="col-md-6"
                                 id="especialidadContainer">

                                <label asp-for="Especialidad"
                                       class="form-label">
                                </label>

                                <input asp-for="Especialidad"
                                       class="form-control"
                                       placeholder="Ej. Bases de datos" />

                            </div>


                            <div class="col-md-6"
                                 id="carreraContainer">

                                <label asp-for="CarreraId"
                                       class="form-label">
                                </label>

                                <select asp-for="CarreraId"
                                        class="form-select">

                                    <option value="">
                                        Seleccione una carrera
                                    </option>

                                    @foreach (var carrera in carreras)
                                    {
                                        <option value="@carrera.Id">
                                            @carrera.Nombre
                                        </option>
                                    }

                                </select>

                                <span asp-validation-for="CarreraId"
                                      class="field-validation">
                                </span>

                            </div>


                            <div class="col-md-6"
                                 id="semestreContainer">

                                <label asp-for="Semestre"
                                       class="form-label">
                                </label>

                                <select asp-for="Semestre"
                                        class="form-select">

                                    <option value="">
                                        Seleccione un semestre
                                    </option>

                                    @for (var i = 1; i <= 20; i++)
                                    {
                                        <option value="@i">
                                            @i°
                                        </option>
                                    }

                                </select>

                                <span asp-validation-for="Semestre"
                                      class="field-validation">
                                </span>

                            </div>

                        </div>

                    </div>


                    <!-- ACCESO -->

                    <div class="form-section">

                        <div class="form-section-heading">

                            <span class="form-section-number">
                                03
                            </span>

                            <div>
                                <h3>Acceso al sistema</h3>
                                <p>Configura las credenciales iniciales.</p>
                            </div>

                        </div>


                        <div class="password-field">

                            <label asp-for="Password"
                                   class="form-label">
                            </label>

                            <input asp-for="Password"
                                   class="form-control"
                                   autocomplete="new-password"
                                   placeholder="Contraseña inicial" />

                            <span asp-validation-for="Password"
                                  class="field-validation">
                            </span>

                        </div>

                    </div>


                    <div class="form-actions-admin">

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">

                            Cancelar

                        </a>

                        <button type="submit"
                                class="btn btn-primary">

                            <svg class="button-icon"
                                 viewBox="0 0 24 24"
                                 aria-hidden="true">
                                <path d="m5 12 4 4L19 6" />
                            </svg>

                            Crear usuario

                        </button>

                    </div>

                </form>

            </div>

        </main>


        <aside class="form-side-panel">

            <div class="form-side-icon">

                <svg viewBox="0 0 24 24"
                     aria-hidden="true">
                    <path d="M12 3 4 6v5c0 5.25 3.44 9.67 8 11 4.56-1.33 8-5.75 8-11V6l-8-3Z" />
                    <path d="m9 12 2 2 4-4" />
                </svg>

            </div>

            <span class="section-kicker">
                SEGURIDAD
            </span>

            <h3>
                Acceso administrado
            </h3>

            <p>
                Las cuentas son creadas y administradas por el
                administrador de ExamSecure.
            </p>

            <div class="side-info-list">

                <div>
                    <span class="side-info-dot"></span>
                    <span>Control de roles</span>
                </div>

                <div>
                    <span class="side-info-dot"></span>
                    <span>Datos académicos</span>
                </div>

                <div>
                    <span class="side-info-dot"></span>
                    <span>Credenciales seguras</span>
                </div>

            </div>

        </aside>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }

    <script>
        function actualizarFormulario() {

            const rol =
                document.getElementById("rol").value;

            const carrera =
                document.getElementById("carreraContainer");

            const semestre =
                document.getElementById("semestreContainer");

            const especialidad =
                document.getElementById("especialidadContainer");

            if (rol === "Estudiante") {

                carrera.style.display = "";
                semestre.style.display = "";
                especialidad.style.display = "none";

            }
            else if (rol === "Docente") {

                carrera.style.display = "none";
                semestre.style.display = "none";
                especialidad.style.display = "";

            }
            else {

                carrera.style.display = "none";
                semestre.style.display = "none";
                especialidad.style.display = "none";

            }
        }

        document
            .getElementById("rol")
            .addEventListener(
                "change",
                actualizarFormulario
            );

        actualizarFormulario();
    </script>
}
