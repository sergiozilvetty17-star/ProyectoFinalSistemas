@model EcommerceApp.Models.UsuarioEditViewModel

@{
    ViewData["Title"] = "Editar usuario";

    var carreras = ViewBag.Carreras as List<EcommerceApp.Models.Carrera>
        ?? new List<EcommerceApp.Models.Carrera>();
}

<div class="page-shell">

    <section class="page-hero">

        <div>

            <div class="eyebrow">
                <span class="eyebrow-dot"></span>
                ADMINISTRACIÓN · USUARIOS
            </div>

            <h1>
                Editar usuario
            </h1>

            <p>
                Actualiza la información personal, académica
                y de acceso de la cuenta seleccionada.
            </p>

        </div>

        <div class="hero-actions">

            <a asp-action="Index"
               class="btn btn-outline-secondary">

                <svg class="button-icon"
                     viewBox="0 0 24 24"
                     aria-hidden="true">
                    <path d="M19 12H5" />
                    <path d="m12 19-7-7 7-7" />
                </svg>

                Volver a usuarios

            </a>

        </div>

    </section>


    <div class="form-layout-admin">

        <main class="form-panel">

            <div class="form-panel-header">

                <div class="form-panel-icon primary">

                    <svg viewBox="0 0 24 24"
                         aria-hidden="true">
                        <path d="M12 20h9" />
                        <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z" />
                    </svg>

                </div>

                <div>

                    <span class="section-kicker">
                        CUENTA · @Model.Rol.ToUpper()
                    </span>

                    <h2>
                        Información del usuario
                    </h2>

                    <p>
                        Modifica únicamente los datos que necesites actualizar.
                    </p>

                </div>

            </div>


            <div class="form-panel-body">

                <form asp-action="Edit"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input asp-for="Id"
                           type="hidden" />

                    <input asp-for="Rol"
                           type="hidden" />


                    <div asp-validation-summary="ModelOnly"
                         class="validation-summary">
                    </div>


                    <!-- DATOS PERSONALES -->

                    <div class="form-section">

                        <div class="form-section-heading">

                            <span class="form-section-number">
                                01
                            </span>

                            <div>
                                <h3>Datos personales</h3>
                                <p>Información básica de la cuenta.</p>
                            </div>

                        </div>


                        <div class="row g-3">

                            <div class="col-md-4">

                                <label asp-for="Nombres"
                                       class="form-label">
                                </label>

                                <input asp-for="Nombres"
                                       class="form-control" />

                                <span asp-validation-for="Nombres"
                                      class="field-validation">
                                </span>

                            </div>


                            <div class="col-md-4">

                                <label asp-for="ApellidoPaterno"
                                       class="form-label">
                                </label>

                                <input asp-for="ApellidoPaterno"
                                       class="form-control" />

                                <span asp-validation-for="ApellidoPaterno"
                                      class="field-validation">
                                </span>

                            </div>


                            <div class="col-md-4">

                                <label asp-for="ApellidoMaterno"
                                       class="form-label">
                                </label>

                                <input asp-for="ApellidoMaterno"
                                       class="form-control" />

                            </div>


                            <div class="col-md-6">

                                <label asp-for="CedulaIdentidad"
                                       class="form-label">
                                </label>

                                <input asp-for="CedulaIdentidad"
                                       class="form-control" />

                                <span asp-validation-for="CedulaIdentidad"
                                      class="field-validation">
                                </span>

                            </div>


                            <div class="col-md-6">

                                <label asp-for="Telefono"
                                       class="form-label">
                                </label>

                                <input asp-for="Telefono"
                                       class="form-control" />

                            </div>


                            <div class="col-12">

                                <label asp-for="Email"
                                       class="form-label">
                                </label>

                                <input asp-for="Email"
                                       class="form-control"
                                       type="email" />

                                <span asp-validation-for="Email"
                                      class="field-validation">
                                </span>

                            </div>

                        </div>

                    </div>


                    @if (Model.Rol == "Estudiante")
                    {
                        <div class="form-section">

                            <div class="form-section-heading">

                                <span class="form-section-number">
                                    02
                                </span>

                                <div>
                                    <h3>Datos académicos</h3>
                                    <p>Información correspondiente al estudiante.</p>
                                </div>

                            </div>


                            <div class="row g-3">

                                <div class="col-md-6">

                                    <label asp-for="CarreraId"
                                           class="form-label">
                                    </label>

                                    <select asp-for="CarreraId"
                                            class="form-select">

                                        <option value="">
                                            Seleccione una carrera
                                        </option>

                                        @foreach (var carrera in carreras)
                                        {
                                            <option value="@carrera.Id">
                                                @carrera.Nombre
                                            </option>
                                        }

                                    </select>

                                    <span asp-validation-for="CarreraId"
                                          class="field-validation">
                                    </span>

                                </div>


                                <div class="col-md-6">

                                    <label asp-for="Semestre"
                                           class="form-label">
                                    </label>

                                    <select asp-for="Semestre"
                                            class="form-select">

                                        <option value="">
                                            Seleccione un semestre
                                        </option>

                                        @for (var i = 1; i <= 20; i++)
                                        {
                                            <option value="@i">
                                                @i°
                                            </option>
                                        }

                                    </select>

                                    <span asp-validation-for="Semestre"
                                          class="field-validation">
                                    </span>

                                </div>

                            </div>

                        </div>
                    }


                    @if (Model.Rol == "Docente")
                    {
                        <div class="form-section">

                            <div class="form-section-heading">

                                <span class="form-section-number">
                                    02
                                </span>

                                <div>
                                    <h3>Información docente</h3>
                                    <p>Área de especialización académica.</p>
                                </div>

                            </div>


                            <div>

                                <label asp-for="Especialidad"
                                       class="form-label">
                                </label>

                                <input asp-for="Especialidad"
                                       class="form-control"
                                       placeholder="Ej. Bases de datos" />

                            </div>

                        </div>
                    }


                    <div class="form-section">

                        <div class="form-section-heading">

                            <span class="form-section-number">
                                03
                            </span>

                            <div>
                                <h3>Seguridad</h3>
                                <p>Gestiona la contraseña y estado de la cuenta.</p>
                            </div>

                        </div>


                        <div class="mb-4">

                            <label asp-for="NewPassword"
                                   class="form-label">
                            </label>

                            <input asp-for="NewPassword"
                                   class="form-control"
                                   autocomplete="new-password"
                                   placeholder="Dejar vacío para mantener la actual" />

                            <div class="form-help">
                                Solo completa este campo si deseas cambiar
                                la contraseña actual.
                            </div>

                            <span asp-validation-for="NewPassword"
                                  class="field-validation">
                            </span>

                        </div>


                        <div class="account-status-control">

                            <div>

                                <strong>
                                    Estado de la cuenta
                                </strong>

                                <span>
                                    Permite o bloquea el acceso del usuario.
                                </span>

                            </div>

                            <div class="form-check form-switch">

                                <input asp-for="Activo"
                                       class="form-check-input"
                                       type="checkbox" />

                                <label asp-for="Activo"
                                       class="form-check-label">
                                </label>

                            </div>

                        </div>

                    </div>


                    <div class="form-actions-admin">

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">
                            Cancelar
                        </a>

                        <button type="submit"
                                class="btn btn-primary">

                            <svg class="button-icon"
                                 viewBox="0 0 24 24"
                                 aria-hidden="true">
                                <path d="m5 12 4 4L19 6" />
                            </svg>

                            Guardar cambios

                        </button>

                    </div>

                </form>

            </div>

        </main>


        <aside class="form-side-panel">

            <div class="form-side-icon">

                <svg viewBox="0 0 24 24"
                     aria-hidden="true">
                    <path d="M12 3 4 6v5c0 5.25 3.44 9.67 8 11 4.56-1.33 8-5.75 8-11V6l-8-3Z" />
                    <path d="m9 12 2 2 4-4" />
                </svg>

            </div>

            <span class="section-kicker">
                SEGURIDAD
            </span>

            <h3>
                Cuenta administrada
            </h3>

            <p>
                Los cambios realizados aquí afectan directamente
                el acceso y los datos académicos del usuario.
            </p>

            <div class="side-info-list">

                <div>
                    <span class="side-info-dot"></span>
                    <span>Rol: @Model.Rol</span>
                </div>

                <div>
                    <span class="side-info-dot"></span>
                    <span>Datos protegidos</span>
                </div>

                <div>
                    <span class="side-info-dot"></span>
                    <span>Acceso controlado</span>
                </div>

            </div>

        </aside>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }

}
