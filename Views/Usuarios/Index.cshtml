@model IEnumerable<EcommerceApp.Models.ApplicationUser>

@{
    ViewData["Title"] = "Usuarios";

    var rolesPorUsuario =
        ViewBag.RolesPorUsuario as Dictionary<string, string>
        ?? new Dictionary<string, string>();
}

<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <span class="badge bg-dark mb-2">
                EXAMSECURE
            </span>

            <h1 class="display-6 fw-bold mb-1">
                Gestion de usuarios
            </h1>

            <p class="text-muted mb-0">
                Administra estudiantes y docentes del sistema.
            </p>
        </div>

        <div class="d-flex gap-2">

            <a asp-controller="Home"
               asp-action="Index"
               class="btn btn-outline-secondary">
                Panel
            </a>

            <a asp-action="Create"
               class="btn btn-dark">
                + Nuevo usuario
            </a>

        </div>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    <div class="card shadow-sm border-0">

        <div class="card-header bg-dark text-white py-3">
            <strong>Usuarios registrados</strong>
        </div>

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>
                            <th class="ps-4">
                                Nombre completo
                            </th>

                            <th>
                                C.I.
                            </th>

                            <th>
                                Correo
                            </th>

                            <th>
                                Rol
                            </th>

                            <th>
                                Estado
                            </th>

                            <th>
                                Creado
                            </th>

                            <th class="text-end pe-4">
                                Acciones
                            </th>
                        </tr>

                    </thead>

                    <tbody>

                    @foreach (var usuario in Model)
                    {
                        var rol =
                            rolesPorUsuario.ContainsKey(usuario.Id)
                                ? rolesPorUsuario[usuario.Id]
                                : "Sin rol";

                        var desactivado =
                            usuario.LockoutEnd.HasValue &&
                            usuario.LockoutEnd.Value >
                            DateTimeOffset.UtcNow;

                        <tr>

                            <td class="ps-4">
                                <strong>
                                    @usuario.NombreCompleto
                                </strong>
                            </td>

                            <td>
                                @(usuario.CedulaIdentidad ?? "�")
                            </td>

                            <td>
                                @usuario.Email
                            </td>

                            <td>

                                @if (rol == "Administrador")
                                {
                                    <span class="badge bg-dark">
                                        Administrador
                                    </span>
                                }
                                else if (rol == "Docente")
                                {
                                    <span class="badge bg-primary">
                                        Docente
                                    </span>
                                }
                                else if (rol == "Estudiante")
                                {
                                    <span class="badge bg-secondary">
                                        Estudiante
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-dark">
                                        Sin rol
                                    </span>
                                }

                            </td>

                            <td>

                                @if (desactivado)
                                {
                                    <span class="badge bg-danger">
                                        Inactivo
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-success">
                                        Activo
                                    </span>
                                }

                            </td>

                            <td>
    @usuario.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
</td>

                            <td class="text-end pe-4">

                                @if (rol != "Administrador")
                                {
                                    <a asp-action="Edit"
                                       asp-route-id="@usuario.Id"
                                       class="btn btn-sm btn-outline-dark">
                                        Editar
                                    </a>

                                    <form asp-action="ToggleEstado"
                                          method="post"
                                          class="d-inline">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="id"
                                               value="@usuario.Id" />

                                        @if (desactivado)
                                        {
                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-success">
                                                Activar
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger">
                                                Desactivar
                                            </button>
                                        }

                                    </form>
                                }
                                else
                                {
                                    <span class="text-muted small">
                                        Cuenta protegida
                                    </span>
                                }

                            </td>

                        </tr>
                    }

                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7"
                                class="text-center py-5 text-muted">
                                No existen usuarios registrados.
                            </td>
                        </tr>
                    }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>
