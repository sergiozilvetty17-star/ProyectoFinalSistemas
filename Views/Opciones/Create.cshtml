@model EcommerceApp.Models.OpcionCreateViewModel

@{
    ViewData["Title"] = "Nueva opción";

    var pregunta = ViewBag.Pregunta as EcommerceApp.Models.Pregunta;
    var examen = pregunta?.Examen;
}

<div class="page-shell">

    <div class="page-hero">
        <div>
            <span class="eyebrow">
                <span class="eyebrow-dot"></span>
                CONSTRUCTOR DE EXAMEN
            </span>

            <h1>Nueva opción</h1>

            <p>
                @(examen?.Titulo ?? "Examen")
                <span class="hero-separator">/</span>
                @(examen?.Materia?.Nombre ?? "Materia")
            </p>
        </div>

        <a asp-action="Index"
           asp-route-preguntaId="@Model.PreguntaId"
           class="btn btn-secondary">

            <span class="button-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M19 12H5M11 18l-6-6 6-6" />
                </svg>
            </span>

            Volver a opciones
        </a>
    </div>

    <div class="form-layout question-form-layout">

        <div class="form-panel">

            <div class="form-panel-header">

                <div class="form-panel-icon primary">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M6 4.5h12A1.5 1.5 0 0 1 19.5 6v12a1.5 1.5 0 0 1-1.5 1.5H6A1.5 1.5 0 0 1 4.5 18V6A1.5 1.5 0 0 1 6 4.5Z" />
                        <path d="M8 9h8M8 13h5" />
                    </svg>
                </div>

                <div>
                    <span class="section-kicker">
                        NUEVA OPCIÓN
                    </span>

                    <h2>Respuesta posible</h2>

                    <p>
                        Define el texto y determina si es la respuesta correcta.
                    </p>
                </div>

            </div>

            <form asp-action="Create"
                  method="post"
                  class="examsecure-form">

                @Html.AntiForgeryToken()

                <input asp-for="PreguntaId" type="hidden" />

                <div class="validation-summary"
                     asp-validation-summary="ModelOnly">
                </div>

                <div class="form-section">

                    <div class="form-section-heading">

                        <span class="form-section-number">
                            01
                        </span>

                        <div>
                            <strong>Contenido</strong>
                            <span>Escribe la alternativa de respuesta.</span>
                        </div>

                    </div>

                    <div class="form-group">

                        <label asp-for="Texto"
                               class="form-label">
                            Texto de la opción
                        </label>

                        <textarea asp-for="Texto"
                                  class="form-control question-textarea"
                                  rows="5"
                                  maxlength="1000"
                                  placeholder="Escribe aquí la opción de respuesta..."></textarea>

                        <span asp-validation-for="Texto"
                              class="field-validation">
                        </span>

                    </div>

                </div>

                <div class="form-section">

                    <div class="form-section-heading">

                        <span class="form-section-number">
                            02
                        </span>

                        <div>
                            <strong>Configuración</strong>
                            <span>Define el orden y la respuesta correcta.</span>
                        </div>

                    </div>

                    <div class="form-layout form-layout-small">

                        <div class="form-group">

                            <label asp-for="Orden"
                                   class="form-label">
                                Orden
                            </label>

                            <input asp-for="Orden"
                                   type="number"
                                   min="1"
                                   class="form-control" />

                            <span class="form-help">
                                Posición de la opción dentro de la pregunta.
                            </span>

                            <span asp-validation-for="Orden"
                                  class="field-validation">
                            </span>

                        </div>

                        <div class="form-group">

                            <label class="form-label">
                                Respuesta correcta
                            </label>

                            <label class="exam-toggle-card">

                                <input asp-for="EsCorrecta"
                                       type="checkbox"
                                       class="exam-toggle-input" />

                                <span class="exam-toggle-slider"></span>

                                <span class="exam-toggle-content">

                                    <span class="exam-toggle-icon">
                                        <svg viewBox="0 0 24 24" aria-hidden="true">
                                            <path d="m5 12 4 4L19 6" />
                                        </svg>
                                    </span>

                                    <span>
                                        <strong>Marcar como correcta</strong>
                                        <small>
                                            Esta opción será válida para la calificación.
                                        </small>
                                    </span>

                                </span>

                            </label>

                        </div>

                    </div>

                </div>

                <div class="form-actions-admin">

                    <a asp-action="Index"
                       asp-route-preguntaId="@Model.PreguntaId"
                       class="btn btn-secondary">
                        Cancelar
                    </a>

                    <button type="submit"
                            class="btn btn-primary">

                        <span class="button-icon">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M12 5v14M5 12h14" />
                            </svg>
                        </span>

                        Crear opción
                    </button>

                </div>

            </form>

        </div>

        <aside class="form-side-panel">

            <div class="form-side-icon cyan">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="m12 3 2.7 5.5 6.1.9-4.4 4.3 1 6.1-5.4-2.9-5.4 2.9 1-6.1-4.4-4.3 6.1-.9L12 3Z" />
                </svg>
            </div>

            <span class="section-kicker">
                PREGUNTA
            </span>

            <h3>
                @(pregunta?.Enunciado ?? "Pregunta")
            </h3>

            <p>
                @(pregunta?.Tipo.ToString() ?? "Tipo de pregunta")
            </p>

            <div class="side-info-list">

                <div class="question-type-info">

                    <span class="side-info-number">
                        01
                    </span>

                    <div>
                        <strong>Orden</strong>
                        <p>
                            Las opciones aparecerán según su posición.
                        </p>
                    </div>

                </div>

                <div class="question-type-info">

                    <span class="side-info-number">
                        02
                    </span>

                    <div>
                        <strong>Correcta</strong>
                        <p>
                            La opción marcada se utilizará para calificar.
                        </p>
                    </div>

                </div>

                <div class="question-type-info">

                    <span class="side-info-number">
                        03
                    </span>

                    <div>
                        <strong>Estudiante</strong>
                        <p>
                            Verá las opciones durante el examen.
                        </p>
                    </div>

                </div>

            </div>

        </aside>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
