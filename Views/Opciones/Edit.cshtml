@model EcommerceApp.Models.OpcionCreateViewModel

@{
    ViewData["Title"] = "Editar opción";

    var pregunta = ViewBag.Pregunta as EcommerceApp.Models.Pregunta;
    var examen = pregunta?.Examen;
}

<div class="page-shell">

    <div class="page-hero">

        <div>

            <span class="eyebrow">
                <span class="eyebrow-dot"></span>
                CONSTRUCTOR DE EXAMEN
            </span>

            <h1>Editar opción</h1>

            <p>
                @(examen?.Titulo ?? "Examen")
                <span class="hero-separator">/</span>
                @(examen?.Materia?.Nombre ?? "Materia")
            </p>

        </div>

        <a asp-action="Index"
           asp-route-preguntaId="@Model.PreguntaId"
           class="btn btn-secondary">

            <span class="button-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M19 12H5M11 18l-6-6 6-6" />
                </svg>
            </span>

            Volver a opciones

        </a>

    </div>

    <div class="form-layout question-form-layout">

        <div class="form-panel">

            <div class="form-panel-header">

                <div class="form-panel-icon primary">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="m4 16 9-9 4 4-9 9H4v-4Z" />
                        <path d="m13 7 2-2 4 4-2 2" />
                    </svg>
                </div>

                <div>

                    <span class="section-kicker">
                        EDITAR OPCIÓN
                    </span>

                    <h2>Modificar respuesta</h2>

                    <p>
                        Actualiza el contenido y configuración de esta opción.
                    </p>

                </div>

            </div>

            <form asp-action="Edit"
                  method="post"
                  class="examsecure-form">

                @Html.AntiForgeryToken()

                <input asp-for="PreguntaId"
                       type="hidden" />

                <div class="validation-summary"
                     asp-validation-summary="ModelOnly">
                </div>

                <div class="form-section">

                    <div class="form-section-heading">

                        <span class="form-section-number">
                            01
                        </span>

                        <div>
                            <strong>Contenido</strong>
                            <span>Modifica el texto de la alternativa.</span>
                        </div>

                    </div>

                    <div class="form-group">

                        <label asp-for="Texto"
                               class="form-label">
                            Texto de la opción
                        </label>

                        <textarea asp-for="Texto"
                                  class="form-control question-textarea"
                                  rows="5"
                                  maxlength="1000"></textarea>

                        <span asp-validation-for="Texto"
                              class="field-validation">
                        </span>

                    </div>

                </div>

                <div class="form-section">

                    <div class="form-section-heading">

                        <span class="form-section-number">
                            02
                        </span>

                        <div>
                            <strong>Configuración</strong>
                            <span>Actualiza el orden y la respuesta correcta.</span>
                        </div>

                    </div>

                    <div class="form-layout form-layout-small">

                        <div class="form-group">

                            <label asp-for="Orden"
                                   class="form-label">
                                Orden
                            </label>

                            <input asp-for="Orden"
                                   type="number"
                                   min="1"
                                   class="form-control" />

                            <span class="form-help">
                                Posición de la opción dentro de la pregunta.
                            </span>

                            <span asp-validation-for="Orden"
                                  class="field-validation">
                            </span>

                        </div>

                        <div class="form-group">

                            <label class="form-label">
                                Respuesta correcta
                            </label>

                            <label class="exam-toggle-card">

                                <input asp-for="EsCorrecta"
                                       type="checkbox"
                                       class="exam-toggle-input" />

                                <span class="exam-toggle-slider"></span>

                                <span class="exam-toggle-content">

                                    <span class="exam-toggle-icon">
                                        <svg viewBox="0 0 24 24" aria-hidden="true">
                                            <path d="m5 12 4 4L19 6" />
                                        </svg>
                                    </span>

                                    <span>
                                        <strong>Marcar como correcta</strong>
                                        <small>
                                            Esta opción será válida para la calificación.
                                        </small>
                                    </span>

                                </span>

                            </label>

                        </div>

                    </div>

                </div>

                <div class="form-actions-admin">

                    <a asp-action="Index"
                       asp-route-preguntaId="@Model.PreguntaId"
                       class="btn btn-secondary">
                        Cancelar
                    </a>

                    <button type="submit"
                            class="btn btn-primary">

                        <span class="button-icon">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path d="m4 16 9-9 4 4-9 9H4v-4Z" />
                                <path d="m13 7 2-2 4 4-2 2" />
                            </svg>
                        </span>

                        Guardar cambios

                    </button>

                </div>

            </form>

        </div>

        <aside class="form-side-panel">

            <div class="form-side-icon cyan">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M12 3.5 14.6 9l5.9.8-4.3 4.1 1 5.8L12 17l-5.2 2.7 1-5.8L3.5 9.8 9.4 9 12 3.5Z" />
                </svg>
            </div>

            <span class="section-kicker">
                PREGUNTA
            </span>

            <h3>
                @(pregunta?.Enunciado ?? "Pregunta")
            </h3>

            <p>
                @(pregunta?.Tipo.ToString() ?? "Tipo de pregunta")
            </p>

            <div class="side-info-list">

                <div class="question-type-info">

                    <span class="side-info-number">
                        01
                    </span>

                    <div>
                        <strong>Contenido</strong>
                        <p>
                            Puedes modificar el texto sin cambiar la pregunta.
                        </p>
                    </div>

                </div>

                <div class="question-type-info">

                    <span class="side-info-number">
                        02
                    </span>

                    <div>
                        <strong>Correcta</strong>
                        <p>
                            Solo una opción puede quedar marcada como correcta.
                        </p>
                    </div>

                </div>

            </div>

        </aside>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
