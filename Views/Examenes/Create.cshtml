@model EcommerceApp.Models.Examen

@{
    ViewData["Title"] = "Nuevo examen";
    var materias = ViewBag.Materias as List<EcommerceApp.Models.Materia>;
}

<div class="container py-5">

    <div class="mb-4">
        <span class="badge bg-dark mb-2">EXAMSECURE</span>

        <h1 class="fw-bold">
            Nuevo examen
        </h1>

        <p class="text-muted">
            Configura una nueva evaluación.
        </p>
    </div>

    <div class="card shadow-sm border-0">

        <div class="card-body p-4">

            <form asp-action="Create" method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="row g-4">

                    <div class="col-12">

                        <label asp-for="Titulo"
                               class="form-label">
                            Título del examen
                        </label>

                        <input asp-for="Titulo"
                               class="form-control form-control-lg"
                               placeholder="Ej. Primer parcial de Programación I" />

                        <span asp-validation-for="Titulo"
                              class="text-danger"></span>

                    </div>

                    <div class="col-md-8">

                        <label asp-for="MateriaId"
                               class="form-label">
                            Materia
                        </label>

                        <select asp-for="MateriaId"
                                class="form-select">

                            <option value="">
                                -- Seleccione una materia --
                            </option>

                            @if (materias != null)
                            {
                                foreach (var materia in materias)
                                {
                                    <option value="@materia.Id">
                                        @materia.Codigo - @materia.Nombre
                                    </option>
                                }
                            }

                        </select>

                        <span asp-validation-for="MateriaId"
                              class="text-danger"></span>

                    </div>

                    <div class="col-md-4">

                        <label asp-for="DuracionMinutos"
                               class="form-label">
                            Duración
                        </label>

                        <div class="input-group">

                            <input asp-for="DuracionMinutos"
                                   class="form-control"
                                   type="number"
                                   min="1"
                                   max="600" />

                            <span class="input-group-text">
                                minutos
                            </span>

                        </div>

                        <span asp-validation-for="DuracionMinutos"
                              class="text-danger"></span>

                    </div>

                    <div class="col-12">

                        <label asp-for="Descripcion"
                               class="form-label">
                            Descripción
                        </label>

                        <textarea asp-for="Descripcion"
                                  class="form-control"
                                  rows="4"
                                  placeholder="Instrucciones o descripción del examen"></textarea>

                        <span asp-validation-for="Descripcion"
                              class="text-danger"></span>

                    </div>

                    <div class="col-md-6">

                        <label asp-for="FechaInicio"
                               class="form-label">
                            Fecha y hora de inicio
                        </label>

                        <input asp-for="FechaInicio"
                               type="datetime-local"
                               class="form-control" />

                        <span asp-validation-for="FechaInicio"
                              class="text-danger"></span>

                    </div>

                    <div class="col-md-6">

                        <label asp-for="FechaFin"
                               class="form-label">
                            Fecha y hora de finalización
                        </label>

                        <input asp-for="FechaFin"
                               type="datetime-local"
                               class="form-control" />

                        <span asp-validation-for="FechaFin"
                              class="text-danger"></span>

                    </div>

                    <div class="col-12">

                        <div class="card bg-light border-0">

                            <div class="card-body">

                                <div class="form-check form-switch">

                                    <input asp-for="RequiereVerificacionFacial"
                                           class="form-check-input"
                                           checked />

                                    <label asp-for="RequiereVerificacionFacial"
                                           class="form-check-label fw-semibold">
                                        Requiere verificación facial
                                    </label>

                                </div>

                                <small class="text-muted">
                                    El estudiante deberá verificar su identidad
                                    antes de iniciar el examen.
                                </small>

                            </div>

                        </div>

                    </div>

                </div>

                <div class="mt-4 d-flex gap-2">

                    <button type="submit"
                            class="btn btn-dark">
                        Crear examen
                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Cancelar
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
