@model EcommerceApp.Models.Examen

@{
    ViewData["Title"] = "Nuevo examen";
    var materias = ViewBag.Materias as List<EcommerceApp.Models.Materia>;
}

<div class="page-shell">

    <section class="page-hero">

        <div>

            <div class="eyebrow">
                <span class="eyebrow-dot"></span>
                EVALUACIONES
            </div>

            <h1>
                Nuevo examen
            </h1>

            <p>
                Configura una nueva evaluación antes de comenzar
                a construir sus preguntas.
            </p>

        </div>

        <div class="hero-actions">

            <a asp-action="Index"
               class="btn btn-outline-secondary">

                <svg class="button-icon"
                     viewBox="0 0 24 24"
                     aria-hidden="true">
                    <path d="M19 12H5" />
                    <path d="m12 19-7-7 7-7" />
                </svg>

                Volver a exámenes

            </a>

        </div>

    </section>


    <div class="form-layout-admin">

        <main class="form-panel">

            <div class="form-panel-header">

                <div class="form-panel-icon primary">

                    <svg viewBox="0 0 24 24"
                         aria-hidden="true">
                        <path d="M5 4h14v16H5z" />
                        <path d="M8 8h8" />
                        <path d="M8 12h8" />
                        <path d="M8 16h5" />
                    </svg>

                </div>

                <div>

                    <span class="section-kicker">
                        CONFIGURACIÓN
                    </span>

                    <h2>
                        Datos del examen
                    </h2>

                    <p>
                        Define la materia, duración, fechas y seguridad
                        de la evaluación.
                    </p>

                </div>

            </div>


            <div class="form-panel-body">

                <form asp-action="Create"
                      method="post">

                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly"
                         class="validation-summary">
                    </div>


                    <div class="form-section">

                        <div class="form-section-heading">

                            <span class="form-section-number">
                                01
                            </span>

                            <div>
                                <h3>Identificación</h3>
                                <p>
                                    Define la información principal de la evaluación.
                                </p>
                            </div>

                        </div>


                        <div class="exam-form-grid">

                            <div class="form-field-full">

                                <label asp-for="Titulo"
                                       class="form-label">
                                    Título del examen
                                </label>

                                <input asp-for="Titulo"
                                       class="form-control"
                                       placeholder="Ej. Primer parcial de Programación I" />

                                <span asp-validation-for="Titulo"
                                      class="field-validation">
                                </span>

                            </div>


                            <div>

                                <label asp-for="MateriaId"
                                       class="form-label">
                                    Materia
                                </label>

                                <select asp-for="MateriaId"
                                        class="form-select">

                                    <option value="">
                                        Seleccionar materia...
                                    </option>

                                    @if (materias != null)
                                    {
                                        foreach (var materia in materias)
                                        {
                                            <option value="@materia.Id">
                                                @materia.Codigo - @materia.Nombre
                                            </option>
                                        }
                                    }

                                </select>

                                <span asp-validation-for="MateriaId"
                                      class="field-validation">
                                </span>

                            </div>


                            <div>

                                <label asp-for="DuracionMinutos"
                                       class="form-label">
                                    Duración
                                </label>

                                <div class="input-with-suffix">

                                    <input asp-for="DuracionMinutos"
                                           class="form-control"
                                           type="number"
                                           min="1"
                                           max="600" />

                                    <span>
                                        min.
                                    </span>

                                </div>

                                <span asp-validation-for="DuracionMinutos"
                                      class="field-validation">
                                </span>

                            </div>

                        </div>

                    </div>


                    <div class="form-section">

                        <div class="form-section-heading">

                            <span class="form-section-number">
                                02
                            </span>

                            <div>
                                <h3>Descripción</h3>
                                <p>
                                    Añade instrucciones o información para los estudiantes.
                                </p>
                            </div>

                        </div>


                        <div class="speech-field">

                            <div class="speech-field-header">

                                <label asp-for="Descripcion"
                                       class="form-label">
                                    Descripción
                                </label>

                                <button type="button"
                                        class="speech-button"
                                        data-speech-target="Descripcion"
                                        aria-label="Dictar descripción del examen">

                                    <svg viewBox="0 0 24 24"
                                         aria-hidden="true">
                                        <path d="M12 3a3 3 0 0 0-3 3v6a3 3 0 0 0 6 0V6a3 3 0 0 0-3-3Z" />
                                        <path d="M19 11a7 7 0 0 1-14 0" />
                                        <path d="M12 18v3" />
                                        <path d="M8 21h8" />
                                    </svg>

                                    <span class="speech-button-text">
                                        Dictar
                                    </span>

                                </button>

                            </div>

                            <textarea asp-for="Descripcion"
                                      class="form-control"
                                      rows="5"
                                      placeholder="Escribe las instrucciones del examen..."></textarea>

                            <div class="speech-status"
                                 data-speech-status-for="Descripcion"
                                 aria-live="polite">
                            </div>

                            <span asp-validation-for="Descripcion"
                                  class="field-validation">
                            </span>

                        </div>

                    </div>


                    <div class="form-section">

                        <div class="form-section-heading">

                            <span class="form-section-number">
                                03
                            </span>

                            <div>
                                <h3>Programación</h3>
                                <p>
                                    Establece la ventana de disponibilidad del examen.
                                </p>
                            </div>

                        </div>


                        <div class="exam-form-grid">

                            <div>

                                <label asp-for="FechaInicio"
                                       class="form-label">
                                    Fecha y hora de inicio
                                </label>

                                <input asp-for="FechaInicio"
                                       type="datetime-local"
                                       class="form-control" />

                                <span asp-validation-for="FechaInicio"
                                      class="field-validation">
                                </span>

                            </div>


                            <div>

                                <label asp-for="FechaFin"
                                       class="form-label">
                                    Fecha y hora de finalización
                                </label>

                                <input asp-for="FechaFin"
                                       type="datetime-local"
                                       class="form-control" />

                                <span asp-validation-for="FechaFin"
                                      class="field-validation">
                                </span>

                            </div>

                        </div>

                    </div>


                    <div class="form-section">

                        <div class="form-section-heading">

                            <span class="form-section-number">
                                04
                            </span>

                            <div>
                                <h3>Seguridad</h3>
                                <p>
                                    Configura la verificación de identidad del estudiante.
                                </p>
                            </div>

                        </div>


                        <label class="exam-toggle-card">

                            <span class="exam-toggle-content">

                                <span class="exam-toggle-icon">

                                    <svg viewBox="0 0 24 24"
                                         aria-hidden="true">
                                        <path d="M12 3 5 6v5c0 4.5 3 8.2 7 10 4-1.8 7-5.5 7-10V6z" />
                                        <circle cx="12" cy="10" r="2" />
                                        <path d="M8.5 16a4.5 4.5 0 0 1 7 0" />
                                    </svg>

                                </span>

                                <span>
                                    <strong>
                                        Requiere verificación facial
                                    </strong>

                                    <small>
                                        El estudiante deberá verificar su identidad
                                        antes de iniciar el examen.
                                    </small>
                                </span>

                            </span>

                            <input asp-for="RequiereVerificacionFacial"
                                   class="exam-toggle-input"
                                   checked />

                            <span class="exam-toggle-slider"></span>

                        </label>

                    </div>


                    <div class="form-actions-admin">

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">
                            Cancelar
                        </a>

                        <button type="submit"
                                class="btn btn-primary">

                            <svg class="button-icon"
                                 viewBox="0 0 24 24"
                                 aria-hidden="true">
                                <path d="M5 4h14v16H5z" />
                                <path d="M8 8h8" />
                                <path d="M8 12h8" />
                            </svg>

                            Crear examen

                        </button>

                    </div>

                </form>

            </div>

        </main>


        <aside class="form-side-panel">

            <div class="form-side-icon">

                <svg viewBox="0 0 24 24"
                     aria-hidden="true">
                    <path d="M5 4h14v16H5z" />
                    <path d="M8 8h8" />
                    <path d="M8 12h8" />
                    <path d="M8 16h5" />
                </svg>

            </div>

            <span class="section-kicker">
                FLUJO DE EVALUACIÓN
            </span>

            <h3>
                Después de crear el examen
            </h3>

            <p>
                El examen comenzará como borrador. Luego podrás
                construir y administrar sus preguntas.
            </p>

            <div class="side-info-list">

                <div>
                    <span class="side-info-dot"></span>
                    <span>Crear el examen</span>
                </div>

                <div>
                    <span class="side-info-dot"></span>
                    <span>Agregar preguntas</span>
                </div>

                <div>
                    <span class="side-info-dot"></span>
                    <span>Revisar la evaluación</span>
                </div>

                <div>
                    <span class="side-info-dot"></span>
                    <span>Publicar para estudiantes</span>
                </div>

            </div>

        </aside>

    </div>

</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script src="~/js/speech/examsecure-speech.js"
            asp-append-version="true"></script>
}

