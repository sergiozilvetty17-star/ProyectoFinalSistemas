@model IEnumerable<EcommerceApp.Models.Examen>

@{
    ViewData["Title"] = "Mis exámenes";
}

<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <span class="badge bg-dark mb-2">EXAMSECURE</span>

            <h1 class="fw-bold mb-1">
                Mis exámenes
            </h1>

            <p class="text-muted mb-0">
                Crea y administra tus evaluaciones.
            </p>
        </div>

        <a asp-action="Create"
           class="btn btn-dark">
            + Nuevo examen
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="card shadow-sm border-0">
            <div class="card-body text-center p-5">

                <h4>No tienes exámenes registrados</h4>

                <p class="text-muted">
                    Crea tu primer examen para comenzar.
                </p>

                <a asp-action="Create"
                   class="btn btn-dark">
                    Crear examen
                </a>

            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-dark">
                        <tr>
                            <th>Examen</th>
                            <th>Materia</th>
                            <th>Inicio</th>
                            <th>Fin</th>
                            <th>Duración</th>
                            <th>Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var examen in Model)
                        {
                            <tr>

                                <td>
                                    <div class="fw-semibold">
                                        @examen.Titulo
                                    </div>

                                    <small class="text-muted">
                                        @(examen.Preguntas?.Count ?? 0) preguntas
                                    </small>
                                </td>

                                <td>
                                    @examen.Materia?.Nombre
                                </td>

                                <td>
                                    @examen.FechaInicio
                                        .ToLocalTime()
                                        .ToString("dd/MM/yyyy HH:mm")
                                </td>

                                <td>
                                    @examen.FechaFin
                                        .ToLocalTime()
                                        .ToString("dd/MM/yyyy HH:mm")
                                </td>

                                <td>
                                    @examen.DuracionMinutos min.
                                </td>

                                <td>
                                    @switch (examen.Estado)
                                    {
                                        case EcommerceApp.Models.EstadoExamen.Borrador:
                                            <span class="badge bg-secondary">
                                                Borrador
                                            </span>
                                            break;

                                        case EcommerceApp.Models.EstadoExamen.Publicado:
                                            <span class="badge bg-success">
                                                Publicado
                                            </span>
                                            break;

                                        case EcommerceApp.Models.EstadoExamen.Cerrado:
                                            <span class="badge bg-dark">
                                                Cerrado
                                            </span>
                                            break;
                                    }
                                </td>

                                <td class="text-end">

                                    <a asp-action="Edit"
                                       asp-route-id="@examen.Id"
                                       class="btn btn-sm btn-outline-dark">
                                        Editar
                                    </a>

                                    @if (examen.Estado ==
                                        EcommerceApp.Models.EstadoExamen.Borrador)
                                    {
                                        <form asp-action="Publicar"
                                              asp-route-id="@examen.Id"
                                              method="post"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-success">
                                                Publicar
                                            </button>

                                        </form>
                                    }

                                    @if (examen.Estado ==
                                        EcommerceApp.Models.EstadoExamen.Publicado)
                                    {
                                        <form asp-action="Cerrar"
                                              asp-route-id="@examen.Id"
                                              method="post"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger">
                                                Cerrar
                                            </button>

                                        </form>
                                    }

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    }

</div>
