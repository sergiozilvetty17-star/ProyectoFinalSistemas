@model IEnumerable<EcommerceApp.Models.Examen>

@{
    ViewData["Title"] = "Mis exámenes";
}

<div class="examsecure-container">

    <section class="examsecure-hero reveal">

        <div class="d-flex justify-content-between align-items-end flex-wrap gap-4">

            <div>

                <div class="examsecure-eyebrow">
                    <span class="examsecure-status-dot"></span>
                    EVALUACIONES
                </div>

                <h1 class="examsecure-title">
                    Mis
                    <span class="examsecure-gradient-text">
                        exámenes.
                    </span>
                </h1>

                <p class="examsecure-subtitle">
                    Diseña, configura y publica evaluaciones
                    para tus estudiantes.
                </p>

            </div>

            <a asp-action="Create"
               class="examsecure-btn examsecure-btn-primary">
                + Nuevo examen
            </a>

        </div>

    </section>


    @if (!Model.Any())
    {
        <div class="examsecure-card p-5 text-center reveal">

            <div class="examsecure-card-icon mx-auto">
                ◆
            </div>

            <h3 class="fw-bold text-white">
                Aún no tienes exámenes
            </h3>

            <p class="text-secondary mb-4">
                Crea tu primera evaluación y comienza a construir
                tu banco de preguntas.
            </p>

            <a asp-action="Create"
               class="examsecure-btn examsecure-btn-primary">
                Crear mi primer examen
            </a>

        </div>
    }
    else
    {
        <div class="examsecure-card overflow-hidden reveal">

            <div class="table-responsive">

                <table class="table examsecure-table align-middle mb-0">

                    <thead>
                        <tr>
                            <th>Evaluación</th>
                            <th>Materia</th>
                            <th>Inicio</th>
                            <th>Finaliza</th>
                            <th>Duración</th>
                            <th>Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var examen in Model)
                        {
                            <tr>

                                <td>

                                    <div class="fw-bold text-white">
                                        @examen.Titulo
                                    </div>

                                    <small class="text-secondary">
                                        @(examen.Preguntas?.Count ?? 0) preguntas
                                    </small>

                                </td>

                                <td>
                                    <span class="text-light">
                                        @examen.Materia?.Nombre
                                    </span>
                                </td>

                                <td>
                                    @examen.FechaInicio.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                </td>

                                <td>
                                    @examen.FechaFin.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                </td>

                                <td>
                                    @examen.DuracionMinutos min.
                                </td>

                                <td>

                                    @switch (examen.Estado)
                                    {
                                        case EcommerceApp.Models.EstadoExamen.Borrador:

                                            <span class="examsecure-badge examsecure-badge-warning">
                                                ● Borrador
                                            </span>

                                            break;

                                        case EcommerceApp.Models.EstadoExamen.Publicado:

                                            <span class="examsecure-badge examsecure-badge-success">
                                                ● Publicado
                                            </span>

                                            break;

                                        case EcommerceApp.Models.EstadoExamen.Cerrado:

                                            <span class="examsecure-badge examsecure-badge-neutral">
                                                ● Cerrado
                                            </span>

                                            break;
                                    }

                                </td>

                                <td class="text-end">

                                    <div class="d-flex justify-content-end gap-2">

                                        <a asp-action="Edit"
                                           asp-route-id="@examen.Id"
                                           class="examsecure-btn examsecure-btn-secondary btn-sm">
                                            Editar
                                        </a>

                                        @if (examen.Estado ==
                                            EcommerceApp.Models.EstadoExamen.Borrador)
                                        {
                                            <form asp-action="Publicar"
                                                  asp-route-id="@examen.Id"
                                                  method="post"
                                                  data-loading>

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="examsecure-btn examsecure-btn-primary btn-sm">
                                                    Publicar
                                                </button>

                                            </form>
                                        }

                                        @if (examen.Estado ==
                                            EcommerceApp.Models.EstadoExamen.Publicado)
                                        {
                                            <form asp-action="Cerrar"
                                                  asp-route-id="@examen.Id"
                                                  method="post"
                                                  data-loading>

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="examsecure-btn examsecure-btn-danger btn-sm">
                                                    Cerrar
                                                </button>

                                            </form>
                                        }

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    }

</div>
