@model EcommerceApp.Models.IntentoExamen

@{
    ViewData["Title"] = "Resultado del examen";

    var examen = Model.Examen;
    var respuestas = Model.Respuestas?
        .Where(r => r.Pregunta != null)
        .OrderBy(r => r.Pregunta!.Orden)
        .ThenBy(r => r.Pregunta!.Id)
        .ToList()
        ?? new List<EcommerceApp.Models.Respuesta>();

    var totalPuntos = respuestas.Sum(r => r.Pregunta!.Puntaje);

    var puntosObtenidos = Model.Calificacion ?? 0;

    var porcentaje = totalPuntos > 0
        ? (puntosObtenidos / totalPuntos) * 100
        : 0;

    var correctas = respuestas.Count(r => r.Correcta);

    var incorrectas = respuestas.Count(r => !r.Correcta);

    var porcentajeVisual = Math.Clamp(porcentaje, 0, 100);

    var calificacionTexto = puntosObtenidos.ToString("0.##");
    var porcentajeTexto = porcentaje.ToString("0.##");
    var totalPuntosTexto = totalPuntos.ToString("0.##");
}

<div class="page-shell result-page">

    <section class="page-hero result-hero">

        <div>

            <div class="eyebrow">
                <span class="eyebrow-dot"></span>
                EXAMEN FINALIZADO
            </div>

            <h1>
                Resultado del examen
            </h1>

            <p>
                @(examen?.Titulo ?? "Examen")
            </p>

        </div>

        <div class="hero-actions">

            <a asp-action="Index"
               class="btn btn-outline-secondary">

                <svg class="button-icon"
                     viewBox="0 0 24 24"
                     aria-hidden="true">
                    <path d="M19 12H5" />
                    <path d="m12 19-7-7 7-7" />
                </svg>

                Mis exámenes

            </a>

        </div>

    </section>


    <section class="result-main-card">

        <div class="result-score-panel">

            <div class="result-score-label">
                CALIFICACIÓN OBTENIDA
            </div>

            <div class="result-score">
                @calificacionTexto
            </div>

            <div class="result-score-total">
                de @totalPuntosTexto puntos
            </div>

            <div class="result-progress">

                <div class="result-progress-bar"
                     style="width: @porcentajeVisual.ToString(System.Globalization.CultureInfo.InvariantCulture)%;">
                </div>

            </div>

            <div class="result-percentage">
                @porcentajeTexto%
            </div>

        </div>


        <div class="result-stats-grid">

            <div class="result-stat">

                <div class="result-stat-icon success">

                    <svg viewBox="0 0 24 24"
                         aria-hidden="true">
                        <path d="m5 12 4 4L19 6" />
                    </svg>

                </div>

                <div>
                    <span>Correctas</span>
                    <strong>@correctas</strong>
                </div>

            </div>


            <div class="result-stat">

                <div class="result-stat-icon danger">

                    <svg viewBox="0 0 24 24"
                         aria-hidden="true">
                        <path d="M6 6l12 12" />
                        <path d="M18 6 6 18" />
                    </svg>

                </div>

                <div>
                    <span>Incorrectas</span>
                    <strong>@incorrectas</strong>
                </div>

            </div>


            <div class="result-stat">

                <div class="result-stat-icon primary">

                    <svg viewBox="0 0 24 24"
                         aria-hidden="true">
                        <circle cx="12" cy="12" r="9" />
                        <path d="M12 7v5l3 2" />
                    </svg>

                </div>

                <div>
                    <span>Estado</span>
                    <strong>Finalizado</strong>
                </div>

            </div>

        </div>

    </section>


    <section class="data-panel result-info-panel">

        <div class="data-panel-header">

            <div>

                <span class="section-kicker">
                    INFORMACIÓN DEL EXAMEN
                </span>

                <h2>
                    Detalles del intento
                </h2>

                <p>
                    Información correspondiente a tu evaluación.
                </p>

            </div>

        </div>


        <div class="result-details-grid">

            <div class="result-detail">

                <span>Materia</span>

                <strong>
                    @(examen?.Materia?.Nombre ?? "—")
                </strong>

            </div>


            <div class="result-detail">

                <span>Examen</span>

                <strong>
                    @(examen?.Titulo ?? "—")
                </strong>

            </div>


            <div class="result-detail">

                <span>Inicio</span>

                <strong>
                    @Model.FechaInicio.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                </strong>

            </div>


            <div class="result-detail">

                <span>Finalización</span>

                <strong>
                    @(Model.FechaFin?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "—")
                </strong>

            </div>

        </div>

    </section>


    @if (respuestas.Any())
    {
        <section class="data-panel result-answers-panel">

            <div class="data-panel-header">

                <div>

                    <span class="section-kicker">
                        REVISIÓN
                    </span>

                    <h2>
                        Respuestas del examen
                    </h2>

                    <p>
                        Consulta el resultado obtenido en cada pregunta.
                    </p>

                </div>

                <span class="record-count">
                    @respuestas.Count preguntas
                </span>

            </div>


            <div class="result-answers-list">

                @foreach (var respuesta in respuestas)
                {
                    var pregunta = respuesta.Pregunta;
                    var esCorrecta = respuesta.Correcta;

                    <article class="result-answer-card @(esCorrecta ? "answer-correct" : "answer-incorrect")">

                        <div class="result-answer-header">

                            <div class="result-question-number">
                                @pregunta!.Orden
                            </div>

                            <div class="result-question-content">

                                <span class="result-question-label">
                                    PREGUNTA @pregunta.Orden
                                </span>

                                <h3>
                                    @pregunta.Enunciado
                                </h3>

                            </div>

                            <div class="result-answer-status">

                                @if (esCorrecta)
                                {
                                    <span class="status-badge status-success">

                                        <span class="status-badge-dot"></span>

                                        Correcta

                                    </span>
                                }
                                else
                                {
                                    <span class="status-badge status-danger">

                                        <span class="status-badge-dot"></span>

                                        Incorrecta

                                    </span>
                                }

                            </div>

                        </div>


                        <div class="result-answer-body">

                            <div class="result-answer-detail">

                                <span>Tipo de pregunta</span>

                                <strong>
                                    @pregunta.Tipo
                                </strong>

                            </div>


                            <div class="result-answer-detail">

                                <span>Puntaje obtenido</span>

                                <strong>
                                    @respuesta.PuntajeObtenido.ToString("0.##")
                                    / @pregunta.Puntaje.ToString("0.##")
                                </strong>

                            </div>


                            @if (!string.IsNullOrWhiteSpace(respuesta.RespuestaTexto))
                            {
                                <div class="result-response-box">

                                    <span>
                                        Tu respuesta
                                    </span>

                                    <p>
                                        @respuesta.RespuestaTexto
                                    </p>

                                </div>
                            }

                        </div>

                    </article>
                }

            </div>

        </section>
    }


    <div class="result-bottom-actions">

        <a asp-action="Index"
           class="btn btn-primary">

            <svg class="button-icon"
                 viewBox="0 0 24 24"
                 aria-hidden="true">
                <path d="M3 12h18" />
                <path d="m8 7-5 5 5 5" />
            </svg>

            Volver a mis exámenes

        </a>

    </div>

</div>
