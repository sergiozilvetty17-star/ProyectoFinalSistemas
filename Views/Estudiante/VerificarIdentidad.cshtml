@model EcommerceApp.Models.IntentoExamen

@{
    ViewData["Title"] = "Verificación de identidad";
    var examen = Model.Examen;
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-7">

            <div class="text-center mb-4">

                <div class="small text-uppercase text-secondary fw-semibold mb-2">
                    Seguridad de ExamSecure
                </div>

                <h1 class="display-6 fw-bold">
                    Verificación de identidad
                </h1>

                <p class="text-secondary mb-0">
                    Verifica tu identidad antes de comenzar el examen.
                </p>

            </div>

            <div class="card border-0 shadow-sm overflow-hidden">

                <div class="card-body p-4 p-md-5">

                    <div class="text-center mb-4">

                        <h2 class="h4 fw-bold mb-2">
                            @(examen?.Titulo ?? "Examen")
                        </h2>

                        <p class="text-secondary mb-0">
                            @(examen?.Materia?.Nombre ?? "Materia")
                        </p>

                    </div>

                    <div class="alert alert-secondary border-0 mb-4">
                        <div class="fw-semibold mb-1">
                            Antes de continuar
                        </div>

                        <div class="small">
                            Permite el acceso a la cámara cuando el navegador lo solicite.
                            Coloca tu rostro frente a la cámara y asegúrate de que sea
                            claramente visible.
                        </div>
                    </div>

                    <div class="camera-container rounded-4 overflow-hidden mb-4"
                         style="background:#111; min-height:360px; position:relative;">

                        <video id="video"
                               class="w-100 h-100"
                               autoplay
                               muted
                               playsinline
                               style="display:block; min-height:360px; object-fit:cover;">
                        </video>

                        <div id="faceIndicator"
                             style="
                                position:absolute;
                                inset:20px;
                                border:2px solid rgba(255,255,255,.35);
                                border-radius:24px;
                                pointer-events:none;
                             ">
                        </div>

                    </div>

                    <div id="cameraStatus"
                         class="text-center text-secondary small mb-4">
                        Preparando reconocimiento facial...
                    </div>

                    <div class="d-grid gap-2">

                        <button type="button"
                                id="btnVerificar"
                                class="btn btn-primary btn-lg"
                                disabled>
                            Verificar identidad
                        </button>

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">
                            Cancelar
                        </a>

                    </div>

                    <div id="verificationResult"
                         class="mt-4"
                         style="display:none;">
                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

<form id="antiForgeryForm" style="display:none;">
    @Html.AntiForgeryToken()
</form>

@section Scripts
{
    <script src="~/js/facial/face-api.js"></script>

    <script>

        const video = document.getElementById("video");
        const status = document.getElementById("cameraStatus");
        const button = document.getElementById("btnVerificar");
        const result = document.getElementById("verificationResult");

        const token = document.querySelector(
            '#antiForgeryForm input[name="__RequestVerificationToken"]'
        ).value;

        const intentoId = @Model.Id;

        const rutaModelos = "/models/face";

        let stream = null;
        let modelosCargados = false;
        let rostroDetectado = false;
        let verificando = false;

        const detectorOptions =
            new faceapi.TinyFaceDetectorOptions({
                inputSize: 320,
                scoreThreshold: 0.5
            });

        function mostrarResultado(tipo, mensaje) {

            result.style.display = "block";

            result.innerHTML = `
                <div class="alert alert-${tipo} border-0 mb-0">
                    ${mensaje}
                </div>
            `;
        }

        async function cargarModelos() {

            try {

                status.textContent =
                    "Cargando modelos de reconocimiento facial...";

                await Promise.all([

                    faceapi.nets.tinyFaceDetector.loadFromUri(
                        rutaModelos
                    ),

                    faceapi.nets.faceLandmark68Net.loadFromUri(
                        rutaModelos
                    ),

                    faceapi.nets.faceRecognitionNet.loadFromUri(
                        rutaModelos
                    )

                ]);

                modelosCargados = true;

                status.textContent =
                    "Modelos cargados. Preparando cámara...";

            }
            catch (error) {

                console.error(error);

                status.textContent =
                    "No fue posible cargar el reconocimiento facial.";

                mostrarResultado(
                    "danger",
                    "No se pudieron cargar los modelos de reconocimiento facial."
                );

            }

        }

        async function iniciarCamara() {

            try {

                stream = await navigator.mediaDevices.getUserMedia({

                    video: {
                        facingMode: "user",
                        width: { ideal: 1280 },
                        height: { ideal: 720 }
                    },

                    audio: false

                });

                video.srcObject = stream;

                await video.play();

                status.textContent =
                    "Cámara activa. Buscando tu rostro...";

                iniciarDeteccion();

            }
            catch (error) {

                console.error(error);

                status.textContent =
                    "No fue posible acceder a la cámara.";

                mostrarResultado(
                    "danger",
                    "Debes permitir el acceso a la cámara para continuar con el examen."
                );

            }

        }

        async function iniciarDeteccion() {

            while (
                stream &&
                stream.active &&
                !verificando
            ) {

                if (!modelosCargados) {
                    await new Promise(resolve =>
                        setTimeout(resolve, 300)
                    );
                    continue;
                }

                if (
                    video.readyState >= 2 &&
                    video.videoWidth > 0
                ) {

                    try {

                        const detecciones =
                            await faceapi
                                .detectAllFaces(
                                    video,
                                    detectorOptions
                                )
                                .withFaceLandmarks()
                                .withFaceDescriptors();

                        if (detecciones.length === 0) {

                            rostroDetectado = false;
                            button.disabled = true;

                            status.textContent =
                                "No se detecta ningún rostro.";

                        }
                        else if (detecciones.length > 1) {

                            rostroDetectado = false;
                            button.disabled = true;

                            status.textContent =
                                "Se detectaron varios rostros. Debe haber una sola persona.";

                        }
                        else {

                            rostroDetectado = true;
                            button.disabled = false;

                            status.textContent =
                                "Rostro detectado. Puedes verificar tu identidad.";

                        }

                    }
                    catch (error) {

                        console.error(
                            "Error durante la detección facial:",
                            error
                        );

                    }

                }

                await new Promise(resolve =>
                    setTimeout(resolve, 500)
                );

            }

        }

        async function verificarIdentidad() {

            if (verificando || !rostroDetectado) {
                return;
            }

            verificando = true;
            button.disabled = true;

            status.textContent =
                "Analizando tu rostro...";

            result.style.display = "none";

            try {

                const detecciones =
                    await faceapi
                        .detectAllFaces(
                            video,
                            detectorOptions
                        )
                        .withFaceLandmarks()
                        .withFaceDescriptors();

                if (detecciones.length === 0) {

                    throw new Error(
                        "No se detectó ningún rostro."
                    );

                }

                if (detecciones.length > 1) {

                    throw new Error(
                        "Se detectaron varios rostros."
                    );

                }

                const descriptor =
                    Array.from(
                        detecciones[0].descriptor
                    );

                const respuesta =
                    await fetch(
                        "@Url.Action("VerificarRostro", "Estudiante")",
                        {
                            method: "POST",

                            headers: {
                                "Content-Type":
                                    "application/x-www-form-urlencoded; charset=UTF-8"
                            },

                            body:
                                new URLSearchParams({

                                    __RequestVerificationToken:
                                        token,

                                    id:
                                        intentoId.toString(),

                                    descriptor:
                                        descriptor.join(",")

                                })

                        }
                    );

                const datos = await respuesta.json();

                if (datos.success === true) {

                    status.textContent =
                        "Identidad verificada correctamente.";

                    mostrarResultado(
                        "success",
                        "Identidad verificada. Iniciando el examen..."
                    );

                    detenerCamara();

                    setTimeout(() => {

                        window.location.href =
                            "@Url.Action("ResolverExamen", "Estudiante", new { id = Model.Id })";

                    }, 800);

                    return;
                }

                verificando = false;
                button.disabled = false;

                status.textContent =
                    "La identidad no pudo ser verificada.";

                mostrarResultado(
                    "danger",
                    datos.message ||
                    "El rostro no coincide con el registro facial."
                );

            }
            catch (error) {

                console.error(error);

                verificando = false;
                button.disabled = false;

                status.textContent =
                    "No fue posible completar la verificación.";

                mostrarResultado(
                    "danger",
                    error.message ||
                    "Ocurrió un error durante la verificación."
                );

            }

        }

        function detenerCamara() {

            if (stream) {

                stream
                    .getTracks()
                    .forEach(track => track.stop());

                stream = null;

            }

        }

        button.addEventListener(
            "click",
            verificarIdentidad
        );

        window.addEventListener(
            "beforeunload",
            detenerCamara
        );

        async function iniciar() {

            await cargarModelos();

            if (modelosCargados) {
                await iniciarCamara();
            }

        }

        iniciar();

    </script>
}
