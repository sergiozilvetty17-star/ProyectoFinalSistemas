@model EcommerceApp.Models.LoginViewModel

@{
    ViewData["Title"] = "Iniciar sesión";
}

<div class="examsecure-login">

    <div class="examsecure-container">

        <div class="examsecure-login-shell reveal">

            <section class="examsecure-login-brand">

                <div class="examsecure-eyebrow mb-4">

                    <span class="examsecure-status-dot"></span>

                    SISTEMA ACTIVO

                </div>

                <div class="examsecure-logo mb-4"
                     style="width:64px;height:64px;border-radius:18px;font-size:1.2rem;">
                    ES
                </div>

                <h1 class="display-4 fw-black fw-bold"
                    style="letter-spacing:-.05em;">

                    Evaluación

                    <span class="examsecure-gradient-text">
                        segura.
                    </span>

                </h1>

                <p class="examsecure-subtitle mt-3">

                    Una plataforma diseñada para proteger
                    la integridad de cada evaluación universitaria.

                </p>


                <div class="mt-5">

                    <div class="d-flex align-items-center gap-3 mb-3">

                        <div class="examsecure-card-icon mb-0">
                            ✓
                        </div>

                        <div>

                            <div class="fw-semibold">
                                Identidad protegida
                            </div>

                            <div class="small text-secondary">
                                Verificación de identidad y acceso.
                            </div>

                        </div>

                    </div>


                    <div class="d-flex align-items-center gap-3 mb-3">

                        <div class="examsecure-card-icon mb-0">
                            ◉
                        </div>

                        <div>

                            <div class="fw-semibold">
                                Monitoreo inteligente
                            </div>

                            <div class="small text-secondary">
                                Eventos relevantes registrados.
                            </div>

                        </div>

                    </div>


                    <div class="d-flex align-items-center gap-3">

                        <div class="examsecure-card-icon mb-0">
                            ◆
                        </div>

                        <div>

                            <div class="fw-semibold">
                                Resultados confiables
                            </div>

                            <div class="small text-secondary">
                                Evaluaciones trazables y seguras.
                            </div>

                        </div>

                    </div>

                </div>

            </section>


            <section class="examsecure-login-form">

                <div class="examsecure-login-form-inner">

                    <div class="mb-5">

                        <div class="small text-uppercase fw-bold text-secondary mb-2"
                             style="letter-spacing:.12em;">
                            Bienvenido
                        </div>

                        <h2 class="fw-bold mb-2">
                            Inicia sesión
                        </h2>

                        <p class="text-secondary mb-0">
                            Ingresa tus credenciales para continuar.
                        </p>

                    </div>


                    <form asp-action="Login"
                          method="post"
                          data-loading>

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger"
                             style="background:rgba(244,63,94,.08);border-color:rgba(244,63,94,.2);color:#fda4af;">
                        </div>


                        <div class="mb-4">

                            <label asp-for="Email"
                                   class="form-label text-light">
                                Correo electrónico
                            </label>

                            <input asp-for="Email"
                                   class="form-control examsecure-form-control"
                                   autocomplete="email"
                                   placeholder="nombre@universidad.edu" />

                            <span asp-validation-for="Email"
                                  class="text-danger small">
                            </span>

                        </div>


                        <div class="mb-3">

                            <div class="d-flex justify-content-between">

                                <label asp-for="Password"
                                       class="form-label text-light">
                                    Contraseña
                                </label>

                            </div>

                            <div class="input-group">

                                <input asp-for="Password"
                                       id="loginPassword"
                                       class="form-control examsecure-form-control"
                                       autocomplete="current-password"
                                       placeholder="••••••••" />

                                <button type="button"
                                        class="btn examsecure-btn-secondary"
                                        data-password-toggle="loginPassword">
                                    Mostrar
                                </button>

                            </div>

                            <span asp-validation-for="Password"
                                  class="text-danger small">
                            </span>

                        </div>


                        <div class="form-check mb-4">

                            <input asp-for="RememberMe"
                                   class="form-check-input" />

                            <label asp-for="RememberMe"
                                   class="form-check-label text-secondary">
                                Mantener sesión iniciada
                            </label>

                        </div>


                        <button type="submit"
                                class="examsecure-btn examsecure-btn-primary w-100 py-3">

                            Ingresar a ExamSecure

                        </button>

                    </form>


                    <div class="text-center mt-4">

                        <small class="text-secondary">
                            Acceso administrado por la institución.
                        </small>

                    </div>

                </div>

            </section>

        </div>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}

