@model IEnumerable<EcommerceApp.Models.Inscripcion>

@{
    ViewData["Title"] = "Inscripciones";
}

<div class="page-shell">

    <div class="page-hero">
        <div>
            <span class="eyebrow">GESTIÓN ACADÉMICA</span>
            <h1>Inscripciones</h1>
            <p>
                Administra la relación entre estudiantes y materias
                dentro de ExamSecure.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            <span>＋</span>
            Nueva inscripción
        </a>
    </div>

    <div class="glass-card">

        <div class="section-header">
            <div>
                <h2>Registro de inscripciones</h2>
                <p>
                    @Model.Count() inscripción(es) registrada(s)
                </p>
            </div>
        </div>

        @if (!Model.Any())
        {
            <div class="empty-state">
                <div class="empty-state-icon">◎</div>

                <h3>No existen inscripciones</h3>

                <p>
                    Comienza registrando un estudiante en una materia.
                </p>

                <a asp-action="Create" class="btn btn-primary">
                    Registrar primera inscripción
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table examsecure-table">
                    <thead>
                        <tr>
                            <th>Estudiante</th>
                            <th>Carrera</th>
                            <th>Materia</th>
                            <th>Docente</th>
                            <th>Fecha</th>
                            <th>Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var inscripcion in Model)
                        {
                            var estudiante = inscripcion.Estudiante;
                            var usuario = estudiante?.Usuario;
                            var materia = inscripcion.Materia;
                            var docente = materia?.Docente?.Usuario;

                            <tr>
                                <td>
                                    <div class="table-user">
                                        <div class="user-avatar">
                                            @(usuario?.Nombres?.FirstOrDefault().ToString().ToUpper() ?? "?")
                                        </div>

                                        <div>
                                            <strong>
                                                @(usuario?.NombreCompleto ?? "Sin usuario")
                                            </strong>

                                            <small>
                                                CI:
                                                @(usuario?.CedulaIdentidad ?? "Sin CI")
                                            </small>
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    <span>
                                        @(estudiante?.Carrera?.Nombre ?? "Sin carrera")
                                    </span>
                                </td>

                                <td>
                                    <div>
                                        <strong>
                                            @(materia?.Nombre ?? "Sin materia")
                                        </strong>

                                        <small>
                                            @(materia?.Codigo ?? "")
                                        </small>
                                    </div>
                                </td>

                                <td>
                                    @(docente?.NombreCompleto ?? "Sin docente")
                                </td>

                                <td>
                                    @inscripcion.FechaInscripcion
                                        .ToLocalTime()
                                        .ToString("dd/MM/yyyy")
                                </td>

                                <td>
                                    @if (inscripcion.Activa)
                                    {
                                        <span class="status-badge status-success">
                                            Activa
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-danger">
                                            Inactiva
                                        </span>
                                    }
                                </td>

                                <td class="text-end">
                                    <div class="action-group">

                                        <form asp-action="ToggleEstado"
                                              method="post"
                                              class="inline-form">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@inscripcion.Id" />

                                            <button type="submit"
                                                    class="btn btn-sm @(inscripcion.Activa ? "btn-warning" : "btn-success")"
                                                    title="@(inscripcion.Activa ? "Desactivar" : "Activar")">

                                                @(inscripcion.Activa ? "Desactivar" : "Activar")
                                            </button>
                                        </form>

                                        <form asp-action="Delete"
                                              method="post"
                                              class="inline-form"
                                              onsubmit="return confirm('¿Eliminar definitivamente esta inscripción?');">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@inscripcion.Id" />

                                            <button type="submit"
                                                    class="btn btn-sm btn-danger">
                                                Eliminar
                                            </button>
                                        </form>

                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

    </div>
</div>
