@{
    ViewData["Title"] = "Estudiante";
}

<div class="container py-5">

    <div class="mb-5">
        <span class="badge bg-dark mb-2">EXAMSECURE</span>

        <h1 class="display-5 fw-bold">
            Panel de Estudiante
        </h1>

        <p class="text-muted">
            Accede a tus materias y evaluaciones online.
        </p>
    </div>

    <div class="row g-4">

        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h4>Mis materias</h4>
                    <p class="text-muted">
                        Consulta las materias en las que estás inscrito.
                    </p>
                    <button class="btn btn-dark" disabled>
                        Próximamente
                    </button>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h4>Exámenes disponibles</h4>
                    <p class="text-muted">
                        Revisa tus evaluaciones pendientes.
                    </p>
                    <button class="btn btn-dark" disabled>
                        Próximamente
                    </button>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h4>Mis resultados</h4>
                    <p class="text-muted">
                        Consulta tus calificaciones.
                    </p>
                    <button class="btn btn-dark" disabled>
                        Próximamente
                    </button>
                </div>
            </div>
        </div>

    </div>
</div>
