@{
    ViewData["Title"] = "Panel Estudiante";
}

<div class="examsecure-container">

    <section class="examsecure-hero reveal">

        <div class="examsecure-eyebrow">

            <span class="examsecure-status-dot"></span>

            ESPACIO ESTUDIANTE

        </div>

        <h1 class="examsecure-title">

            Prepárate.

            <span class="examsecure-gradient-text">
                Demuestra lo que sabes.
            </span>

        </h1>

        <p class="examsecure-subtitle">

            Accede a tus evaluaciones y completa cada examen
            bajo un entorno diseñado para garantizar la integridad académica.

        </p>

    </section>


    <section class="row g-4 pb-5">

        <div class="col-md-6 col-xl-4 reveal reveal-delay-1">

            <div class="examsecure-card h-100 p-4">

                <div class="examsecure-card-icon">
                    ▦
                </div>

                <h4 class="text-white fw-bold">
                    Mis materias
                </h4>

                <p class="text-secondary">
                    Consulta tus materias y cursos inscritos.
                </p>

                <span class="examsecure-badge examsecure-badge-neutral">
                    Área académica
                </span>

            </div>

        </div>


        <div class="col-md-6 col-xl-4 reveal reveal-delay-2">

            <div class="examsecure-card h-100 p-4">

                <div class="examsecure-card-icon">
                    ◆
                </div>

                <h4 class="text-white fw-bold">
                    Exámenes disponibles
                </h4>

                <p class="text-secondary">
                    Aquí aparecerán las evaluaciones disponibles
                    para realizar.
                </p>

                <span class="examsecure-badge examsecure-badge-neutral">
                    Sin evaluaciones pendientes
                </span>

            </div>

        </div>


        <div class="col-md-6 col-xl-4 reveal reveal-delay-3">

            <div class="examsecure-card h-100 p-4">

                <div class="examsecure-card-icon">
                    ↗
                </div>

                <h4 class="text-white fw-bold">
                    Mis resultados
                </h4>

                <p class="text-secondary">
                    Consulta tus calificaciones después de completar
                    tus evaluaciones.
                </p>

                <span class="examsecure-badge examsecure-badge-neutral">
                    Historial académico
                </span>

            </div>

        </div>

    </section>

</div>
