@{
    ViewData["Title"] = "Espacio docente";
}

<div class="page-shell">

    <section class="page-hero">

        <div>

            <div class="eyebrow">
                <span class="eyebrow-dot"></span>
                ESPACIO DOCENTE
            </div>

            <h1>
                Tus evaluaciones.
                <span>Bajo control.</span>
            </h1>

            <p>
                Gestiona tus materias, exámenes y resultados desde un solo lugar.
            </p>

        </div>

    </section>


    <section class="dashboard-grid">

        <!-- MIS MATERIAS -->

        <a asp-controller="Docente"
           asp-action="MisMaterias"
           class="dashboard-card-link reveal reveal-delay-1">

            <article class="examsecure-card dashboard-card">

                <div class="dashboard-card-top">

                    <span class="dashboard-card-icon">

                        <svg viewBox="0 0 24 24"
                             aria-hidden="true">
                            <path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v15H6.5A2.5 2.5 0 0 0 4 20.5z" />
                            <path d="M4 5.5v15" />
                            <path d="M8 7h8" />
                            <path d="M8 11h8" />
                        </svg>

                    </span>

                    <span class="status-badge status-success">

                        <span class="status-badge-dot"></span>

                        Activas

                    </span>

                </div>

                <h2>
                    Mis materias
                </h2>

                <p>
                    Consulta las materias que tienes asignadas.
                </p>

                <div class="dashboard-card-footer">

                    <span>
                        Ver materias
                    </span>

                    <svg viewBox="0 0 24 24"
                         aria-hidden="true">
                        <path d="M5 12h14" />
                        <path d="m13 6 6 6-6 6" />
                    </svg>

                </div>

            </article>

        </a>


        <!-- EXÁMENES -->

        <a asp-controller="Examenes"
           asp-action="Index"
           class="dashboard-card-link reveal reveal-delay-2">

            <article class="examsecure-card dashboard-card">

                <div class="dashboard-card-top">

                    <span class="dashboard-card-icon">

                        <svg viewBox="0 0 24 24"
                             aria-hidden="true">
                            <rect x="5" y="3" width="14" height="18" rx="2" />
                            <path d="M9 7h6" />
                            <path d="M9 11h6" />
                            <path d="M9 15h3" />
                        </svg>

                    </span>

                    <span class="status-badge status-primary">

                        <span class="status-badge-dot"></span>

                        Gestión

                    </span>

                </div>

                <h2>
                    Exámenes
                </h2>

                <p>
                    Crea, administra y publica tus evaluaciones.
                </p>

                <div class="dashboard-card-footer">

                    <span>
                        Gestionar exámenes
                    </span>

                    <svg viewBox="0 0 24 24"
                         aria-hidden="true">
                        <path d="M5 12h14" />
                        <path d="m13 6 6 6-6 6" />
                    </svg>

                </div>

            </article>

        </a>


        <!-- RESULTADOS -->

        <a asp-controller="Docente"
           asp-action="Resultados"
           class="dashboard-card-link reveal reveal-delay-3">

            <article class="examsecure-card dashboard-card">

                <div class="dashboard-card-top">

                    <span class="dashboard-card-icon">

                        <svg viewBox="0 0 24 24"
                             aria-hidden="true">
                            <path d="M4 19V5" />
                            <path d="M4 19h16" />
                            <path d="m7 15 3-4 3 2 5-6" />
                        </svg>

                    </span>

                    <span class="status-badge status-primary">

                        <span class="status-badge-dot"></span>

                        Resultados

                    </span>

                </div>

                <h2>
                    Resultados
                </h2>

                <p>
                    Revisa las calificaciones obtenidas por tus estudiantes.
                </p>

                <div class="dashboard-card-footer">

                    <span>
                        Ver resultados
                    </span>

                    <svg viewBox="0 0 24 24"
                         aria-hidden="true">
                        <path d="M5 12h14" />
                        <path d="m13 6 6 6-6 6" />
                    </svg>

                </div>

            </article>

        </a>

    </section>

</div>
