@{
    ViewData["Title"] = "Panel Docente";
}

<div class="examsecure-container">

    <section class="examsecure-hero reveal">

        <div class="examsecure-eyebrow">

            <span class="examsecure-status-dot"></span>

            ESPACIO DOCENTE

        </div>

        <h1 class="examsecure-title">

            Tus evaluaciones.

            <span class="examsecure-gradient-text">
                Bajo control.
            </span>

        </h1>

        <p class="examsecure-subtitle">

            Crea evaluaciones, configura preguntas y controla
            el proceso de evaluación de tus estudiantes.

        </p>

    </section>


    <section class="row g-4 pb-5">

        <div class="col-md-6 col-xl-4 reveal reveal-delay-1">

            <div class="examsecure-card h-100 p-4">

                <div class="examsecure-card-icon">
                    ▦
                </div>

                <h4 class="text-white fw-bold">
                    Mis materias
                </h4>

                <p class="text-secondary">
                    Consulta las materias académicas que tienes asignadas.
                </p>

                <span class="examsecure-badge examsecure-badge-neutral">
                    Gestión académica
                </span>

            </div>

        </div>


        <div class="col-md-6 col-xl-4 reveal reveal-delay-2">

            <a asp-controller="Examenes"
               asp-action="Index"
               class="text-decoration-none">

                <div class="examsecure-card h-100 p-4">

                    <div class="examsecure-card-icon">
                        ◆
                    </div>

                    <h4 class="text-white fw-bold">
                        Exámenes
                    </h4>

                    <p class="text-secondary">
                        Crea, configura y publica tus evaluaciones.
                    </p>

                    <span class="text-primary fw-semibold">
                        Administrar exámenes →
                    </span>

                </div>

            </a>

        </div>


        <div class="col-md-6 col-xl-4 reveal reveal-delay-3">

            <div class="examsecure-card h-100 p-4">

                <div class="examsecure-card-icon">
                    ↗
                </div>

                <h4 class="text-white fw-bold">
                    Resultados
                </h4>

                <p class="text-secondary">
                    Las calificaciones aparecerán aquí cuando
                    tus estudiantes completen evaluaciones.
                </p>

                <span class="examsecure-badge examsecure-badge-neutral">
                    Preparado para resultados
                </span>

            </div>

        </div>

    </section>

</div>
