@{
    ViewData["Title"] = "Administrador";
}

<div class="examsecure-container">

    <section class="examsecure-hero reveal">

        <div class="examsecure-eyebrow">

            <span class="examsecure-status-dot"></span>

            PANEL DE CONTROL

        </div>

        <h1 class="examsecure-title">

            Control total.

            <span class="examsecure-gradient-text">
                Seguridad primero.
            </span>

        </h1>

        <p class="examsecure-subtitle">

            Administra usuarios, estructura académica y configuración
            de la plataforma desde un único centro de control.

        </p>

    </section>


    <section class="row g-4 pb-5">

        <div class="col-md-6 col-xl-4 reveal reveal-delay-1">

            <a asp-controller="Usuarios"
               asp-action="Index"
               class="text-decoration-none">

                <div class="examsecure-card h-100 p-4">

                    <div class="examsecure-card-icon">
                        ◉
                    </div>

                    <h4 class="text-white fw-bold">
                        Usuarios
                    </h4>

                    <p class="text-secondary">
                        Administra estudiantes y docentes,
                        sus datos académicos y estado de acceso.
                    </p>

                    <span class="text-primary fw-semibold">
                        Gestionar usuarios →
                    </span>

                </div>

            </a>

        </div>


        <div class="col-md-6 col-xl-4 reveal reveal-delay-2">

            <a asp-controller="Materias"
               asp-action="Index"
               class="text-decoration-none">

                <div class="examsecure-card h-100 p-4">

                    <div class="examsecure-card-icon">
                        ▦
                    </div>

                    <h4 class="text-white fw-bold">
                        Materias
                    </h4>

                    <p class="text-secondary">
                        Organiza las materias académicas y
                        asigna docentes responsables.
                    </p>

                    <span class="text-primary fw-semibold">
                        Gestionar materias →
                    </span>

                </div>

            </a>

        </div>


        <div class="col-md-6 col-xl-4 reveal reveal-delay-3">

            <div class="examsecure-card h-100 p-4">

                <div class="examsecure-card-icon">
                    ◈
                </div>

                <h4 class="text-white fw-bold">
                    Seguridad
                </h4>

                <p class="text-secondary">
                    El sistema registra eventos de autenticación,
                    actividad y seguridad durante las evaluaciones.
                </p>

                <div class="examsecure-badge examsecure-badge-success">
                    Sistema protegido
                </div>

            </div>

        </div>

    </section>

</div>
