@model IEnumerable<EcommerceApp.Models.Pregunta>

@{
    ViewData["Title"] = "Preguntas";
    var examen = ViewBag.Examen as EcommerceApp.Models.Examen;
    var preguntas = Model.ToList();
    var totalPuntos = preguntas.Sum(p => p.Puntaje);
}

<div class="page-shell">

    <div class="page-hero">
        <div>
            <span class="eyebrow">
                <span class="eyebrow-dot"></span>
                CONSTRUCTOR DE EXAMEN
            </span>

            <h1>
                @(examen?.Titulo ?? "Examen")
            </h1>

            <p>
                @(examen?.Materia?.Nombre ?? "Materia")
                <span class="hero-separator">/</span>
                Construcción y organización de preguntas
            </p>
        </div>

        <div class="hero-actions">

            <a asp-action="Create"
               asp-route-examenId="@examen?.Id"
               class="btn btn-primary">
                <span class="button-icon">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M12 5v14M5 12h14" />
                    </svg>
                </span>
                Nueva pregunta
            </a>

            <a asp-controller="Examenes"
               asp-action="Index"
               class="btn btn-secondary">
                <span class="button-icon">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M19 12H5M11 18l-6-6 6-6" />
                    </svg>
                </span>
                Mis exámenes
            </a>

        </div>
    </div>

    @if (preguntas.Any())
    {
        <div class="admin-summary-grid question-summary-grid">

            <div class="admin-summary-card">
                <div class="admin-summary-icon primary">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M6 4.5h12A1.5 1.5 0 0 1 19.5 6v12a1.5 1.5 0 0 1-1.5 1.5H6A1.5 1.5 0 0 1 4.5 18V6A1.5 1.5 0 0 1 6 4.5Z" />
                        <path d="M8 8h8M8 12h8M8 16h5" />
                    </svg>
                </div>

                <div>
                    <span class="admin-summary-label">Preguntas</span>
                    <strong>@preguntas.Count</strong>
                </div>
            </div>

            <div class="admin-summary-card">
                <div class="admin-summary-icon cyan">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M12 3.5 14.6 9l5.9.8-4.3 4.1 1 5.8L12 17l-5.2 2.7 1-5.8L3.5 9.8 9.4 9 12 3.5Z" />
                    </svg>
                </div>

                <div>
                    <span class="admin-summary-label">Puntaje total</span>
                    <strong>@totalPuntos.ToString("0.##") pts</strong>
                </div>
            </div>

            <div class="admin-summary-card">
                <div class="admin-summary-icon success">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M7 3.5h10A1.5 1.5 0 0 1 18.5 5v14A1.5 1.5 0 0 1 17 20.5H7A1.5 1.5 0 0 1 5.5 19V5A1.5 1.5 0 0 1 7 3.5Z" />
                        <path d="m9 12 2 2 4-4" />
                    </svg>
                </div>

                <div>
                    <span class="admin-summary-label">Estado</span>
                    <strong>En construcción</strong>
                </div>
            </div>

        </div>
    }

    <div class="data-panel question-data-panel">

        <div class="data-panel-header">
            <div>
                <span class="section-kicker">BANCO DE PREGUNTAS</span>

                <h2>
                    Preguntas del examen
                </h2>

                <p>
                    @preguntas.Count pregunta(s) registrada(s)
                </p>
            </div>

            @if (examen != null)
            {
                <div class="exam-context-badge">
                    <span class="status-badge-dot"></span>
                    @examen.Materia?.Nombre
                </div>
            }
        </div>

        @if (!preguntas.Any())
        {
            <div class="empty-state">

                <div class="empty-state-icon">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M6 4.5h12A1.5 1.5 0 0 1 19.5 6v12a1.5 1.5 0 0 1-1.5 1.5H6A1.5 1.5 0 0 1 4.5 18V6A1.5 1.5 0 0 1 6 4.5Z" />
                        <path d="M8 9h8M8 13h5" />
                    </svg>
                </div>

                <h3>Este examen todavía no tiene preguntas</h3>

                <p>
                    Agrega la primera pregunta para comenzar
                    a construir la evaluación.
                </p>

                <a asp-action="Create"
                   asp-route-examenId="@examen?.Id"
                   class="btn btn-primary">
                    <span class="button-icon">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M12 5v14M5 12h14" />
                        </svg>
                    </span>
                    Crear primera pregunta
                </a>

            </div>
        }
        else
        {
            <div class="question-list">

                @foreach (var pregunta in preguntas)
                {
                    <article class="question-card">

                        <div class="question-number">
                            @pregunta.Orden
                        </div>

                        <div class="question-content">

                            <div class="question-header">

                                <div class="question-meta">

                                    <span class="question-type">
                                        @pregunta.Tipo
                                    </span>

                                    <span class="question-score">
                                        @pregunta.Puntaje.ToString("0.##") pts
                                    </span>

                                </div>

                                <div class="action-group">

                                    <a asp-action="Edit"
                                       asp-route-id="@pregunta.Id"
                                       class="table-action table-action-primary">

                                        <svg viewBox="0 0 24 24" aria-hidden="true">
                                            <path d="m14 6 4 4M5 19l1.2-4.2L15.8 5.2a1.7 1.7 0 0 1 2.4 0l.6.6a1.7 1.7 0 0 1 0 2.4l-9.6 9.6L5 19Z" />
                                        </svg>

                                        Editar
                                    </a>

                                    <form asp-action="Delete"
                                          method="post"
                                          class="inline-form"
                                          onsubmit="return confirm('¿Eliminar esta pregunta? También se eliminarán sus opciones.');">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="id"
                                               value="@pregunta.Id" />

                                        <button type="submit"
                                                class="table-action table-action-danger">

                                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                                <path d="M5 7h14M10 11v5M14 11v5M8 7l1-3h6l1 3M7 7l.8 13h8.4L17 7" />
                                            </svg>

                                            Eliminar
                                        </button>

                                    </form>

                                </div>

                            </div>

                            <h3 class="question-title">
                                @pregunta.Enunciado
                            </h3>

                            @if (pregunta.Tipo != EcommerceApp.Models.TipoPregunta.RespuestaAbierta)
                            {
                                <div class="question-options">

                                    @if (!pregunta.Opciones.Any())
                                    {
                                        <div class="option-empty">

                                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                                <circle cx="12" cy="12" r="8.5" />
                                                <path d="M12 8v5M12 16h.01" />
                                            </svg>

                                            Esta pregunta todavía no tiene opciones.
                                        </div>
                                    }
                                    else
                                    {
                                        @foreach (var opcion in pregunta.Opciones.OrderBy(o => o.Orden))
                                        {
                                            <div class="question-option @(opcion.EsCorrecta ? "correct-option" : "")">

                                                <span class="option-marker">
                                                    @Convert.ToChar(65 + opcion.Orden - 1)
                                                </span>

                                                <span class="option-text">
                                                    @opcion.Texto
                                                </span>

                                                @if (opcion.EsCorrecta)
                                                {
                                                    <span class="correct-label">

                                                        <svg viewBox="0 0 24 24" aria-hidden="true">
                                                            <path d="m5 12 4 4L19 6" />
                                                        </svg>

                                                        Correcta
                                                    </span>
                                                }

                                            </div>
                                        }
                                    }

                                </div>
                            }
                            else
                            {
                                <div class="open-answer-preview">

                                    <svg viewBox="0 0 24 24" aria-hidden="true">
                                        <path d="M5 4.5h14A1.5 1.5 0 0 1 20.5 6v12a1.5 1.5 0 0 1-1.5 1.5H5A1.5 1.5 0 0 1 3.5 18V6A1.5 1.5 0 0 1 5 4.5Z" />
                                        <path d="M7.5 9h9M7.5 12h6M7.5 15h4" />
                                    </svg>

                                    Respuesta abierta
                                </div>
                            }

                            @if (pregunta.Tipo != EcommerceApp.Models.TipoPregunta.RespuestaAbierta)
                            {
                                <div class="question-footer">

                                    <span class="question-option-count">
                                        @pregunta.Opciones.Count opción(es)
                                    </span>

                                    <a asp-controller="Opciones"
                                       asp-action="Index"
                                       asp-route-preguntaId="@pregunta.Id"
                                       class="btn btn-sm btn-primary">

                                        Gestionar opciones

                                        <svg viewBox="0 0 24 24" aria-hidden="true">
                                            <path d="M5 12h14M13 6l6 6-6 6" />
                                        </svg>

                                    </a>

                                </div>
                            }

                        </div>

                    </article>
                }

            </div>
        }

    </div>

</div>
