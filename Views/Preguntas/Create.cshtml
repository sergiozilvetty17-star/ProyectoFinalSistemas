@model EcommerceApp.Models.PreguntaCreateViewModel

@{
    ViewData["Title"] = "Nueva pregunta";
    var examen = ViewBag.Examen as EcommerceApp.Models.Examen;
}

<div class="page-shell">

    <div class="page-hero">
        <div>
            <span class="eyebrow">
                <span class="eyebrow-dot"></span>
                CONSTRUCTOR DE EXAMEN
            </span>

            <h1>Nueva pregunta</h1>

            <p>
                @(examen?.Titulo ?? "Examen")
                <span class="hero-separator">/</span>
                @(examen?.Materia?.Nombre ?? "Materia")
            </p>
        </div>

        <a asp-action="Index"
           asp-route-examenId="@Model.ExamenId"
           class="btn btn-secondary">

            <span class="button-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M19 12H5M11 18l-6-6 6-6" />
                </svg>
            </span>

            Volver a preguntas
        </a>
    </div>

    <div class="form-layout question-form-layout">

        <div class="form-panel">

            <div class="form-panel-header">

                <div class="form-panel-icon primary">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M6 4.5h12A1.5 1.5 0 0 1 19.5 6v12a1.5 1.5 0 0 1-1.5 1.5H6A1.5 1.5 0 0 1 4.5 18V6A1.5 1.5 0 0 1 6 4.5Z" />
                        <path d="M8 9h8M8 13h5" />
                    </svg>
                </div>

                <div>
                    <span class="section-kicker">NUEVA PREGUNTA</span>
                    <h2>Contenido de la pregunta</h2>
                    <p>
                        Define el enunciado, tipo, puntuación y orden.
                    </p>
                </div>

            </div>

            <form asp-action="Create"
                  method="post"
                  class="examsecure-form">

                @Html.AntiForgeryToken()

                <input asp-for="ExamenId" type="hidden" />

                <div asp-validation-summary="ModelOnly"
                     class="validation-summary"></div>

                <div class="form-section">

                    <div class="form-section-heading">
                        <span class="form-section-number">01</span>

                        <div>
                            <strong>Contenido</strong>
                            <span>Escribe el enunciado de la pregunta.</span>
                        </div>
                    </div>

                    <div class="form-group">

                        <label asp-for="Enunciado" class="form-label">
                            Enunciado
                        </label>

                        <textarea asp-for="Enunciado"
                                  class="form-control question-textarea"
                                  rows="7"
                                  placeholder="Escribe aquí la pregunta..."></textarea>

                        <span asp-validation-for="Enunciado"
                              class="field-validation">
                        </span>

                    </div>

                </div>

                <div class="form-section">

                    <div class="form-section-heading">
                        <span class="form-section-number">02</span>

                        <div>
                            <strong>Configuración</strong>
                            <span>Define el tipo y valor de la pregunta.</span>
                        </div>
                    </div>

                    <div class="form-layout form-layout-small">

                        <div class="form-group">

                            <label asp-for="Tipo" class="form-label">
                                Tipo de pregunta
                            </label>

                            <select asp-for="Tipo"
                                    asp-items="Html.GetEnumSelectList<EcommerceApp.Models.TipoPregunta>()"
                                    class="form-select"
                                    id="tipoPregunta">
                            </select>

                            <span asp-validation-for="Tipo"
                                  class="field-validation">
                            </span>

                        </div>

                        <div class="form-group">

                            <label asp-for="Puntaje" class="form-label">
                                Puntaje
                            </label>

                            <div class="input-with-suffix">
                                <input asp-for="Puntaje"
                                       type="number"
                                       step="0.01"
                                       min="0.01"
                                       class="form-control" />

                                <span>pts</span>
                            </div>

                            <span asp-validation-for="Puntaje"
                                  class="field-validation">
                            </span>

                        </div>

                    </div>

                    <div class="form-group">

                        <label asp-for="Orden" class="form-label">
                            Orden de la pregunta
                        </label>

                        <input asp-for="Orden"
                               type="number"
                               min="1"
                               class="form-control" />

                        <span class="form-help">
                            Define la posición que tendrá dentro del examen.
                        </span>

                        <span asp-validation-for="Orden"
                              class="field-validation">
                        </span>

                    </div>

                </div>

                <div class="form-actions-admin">

                    <a asp-action="Index"
                       asp-route-examenId="@Model.ExamenId"
                       class="btn btn-secondary">
                        Cancelar
                    </a>

                    <button type="submit"
                            class="btn btn-primary">

                        <span class="button-icon">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M12 5v14M5 12h14" />
                            </svg>
                        </span>

                        Crear pregunta
                    </button>

                </div>

            </form>

        </div>

        <aside class="form-side-panel">

            <div class="form-side-icon cyan">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M12 3.5 14.6 9l5.9.8-4.3 4.1 1 5.8L12 17l-5.2 2.7 1-5.8L3.5 9.8 9.4 9 12 3.5Z" />
                </svg>
            </div>

            <span class="section-kicker">TIPOS DISPONIBLES</span>

            <h3>Diseña diferentes tipos de evaluación</h3>

            <p>
                El tipo de pregunta determina cómo responderá
                el estudiante durante el examen.
            </p>

            <div class="side-info-list">

                <div class="question-type-info">
                    <span class="side-info-number">01</span>

                    <div>
                        <strong>Opción múltiple</strong>
                        <p>
                            Una o varias opciones de respuesta.
                        </p>
                    </div>
                </div>

                <div class="question-type-info">
                    <span class="side-info-number">02</span>

                    <div>
                        <strong>Verdadero / Falso</strong>
                        <p>
                            Dos alternativas para responder.
                        </p>
                    </div>
                </div>

                <div class="question-type-info">
                    <span class="side-info-number">03</span>

                    <div>
                        <strong>Respuesta abierta</strong>
                        <p>
                            El estudiante escribe su respuesta.
                        </p>
                    </div>
                </div>

            </div>

        </aside>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
