@model EcommerceApp.Models.PreguntaCreateViewModel

@{
    ViewData["Title"] = "Nueva pregunta";
    var examen = ViewBag.Examen as EcommerceApp.Models.Examen;
}

<div class="page-shell">

    <div class="page-hero">
        <div>
            <span class="eyebrow">CONSTRUCTOR DE EXAMEN</span>

            <h1>Nueva pregunta</h1>

            <p>
                @(examen?.Titulo ?? "Examen")
            </p>
        </div>

        <a asp-action="Index"
           asp-route-examenId="@Model.ExamenId"
           class="btn btn-secondary">
            ← Volver a preguntas
        </a>
    </div>

    <div class="form-layout">

        <div class="glass-card">

            <div class="section-header">
                <div>
                    <h2>Contenido de la pregunta</h2>
                    <p>
                        Define el enunciado, tipo y puntuación.
                    </p>
                </div>
            </div>

            <form asp-action="Create"
                  method="post"
                  class="examsecure-form">

                @Html.AntiForgeryToken()

                <input asp-for="ExamenId" type="hidden" />

                <div asp-validation-summary="ModelOnly"
                     class="validation-summary"></div>

                <div class="form-group">

                    <label asp-for="Enunciado">
                        Enunciado
                    </label>

                    <textarea asp-for="Enunciado"
                              class="form-control"
                              rows="6"
                              placeholder="Escribe aquí la pregunta..."></textarea>

                    <span asp-validation-for="Enunciado"
                          class="text-danger">
                    </span>

                </div>

                <div class="form-layout form-layout-small">

                    <div class="form-group">

                        <label asp-for="Tipo">
                            Tipo de pregunta
                        </label>

                        <select asp-for="Tipo"
                                asp-items="Html.GetEnumSelectList<EcommerceApp.Models.TipoPregunta>()"
                                class="form-control"
                                id="tipoPregunta">
                        </select>

                        <span asp-validation-for="Tipo"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="form-group">

                        <label asp-for="Puntaje">
                            Puntaje
                        </label>

                        <input asp-for="Puntaje"
                               type="number"
                               step="0.01"
                               min="0.01"
                               class="form-control" />

                        <span asp-validation-for="Puntaje"
                              class="text-danger">
                        </span>

                    </div>

                </div>

                <div class="form-group">

                    <label asp-for="Orden">
                        Orden de la pregunta
                    </label>

                    <input asp-for="Orden"
                           type="number"
                           min="1"
                           class="form-control" />

                    <span asp-validation-for="Orden"
                          class="text-danger">
                    </span>

                </div>

                <div class="form-actions">

                    <a asp-action="Index"
                       asp-route-examenId="@Model.ExamenId"
                       class="btn btn-secondary">
                        Cancelar
                    </a>

                    <button type="submit"
                            class="btn btn-primary">
                        Crear pregunta
                    </button>

                </div>

            </form>

        </div>

        <div class="glass-card info-card">

            <div class="info-icon">
                ?
            </div>

            <h3>Tipos disponibles</h3>

            <div class="info-list">

                <div>
                    <span>01</span>
                    <p>
                        <strong>Opción múltiple</strong><br />
                        Una o varias opciones de respuesta.
                    </p>
                </div>

                <div>
                    <span>02</span>
                    <p>
                        <strong>Verdadero / Falso</strong><br />
                        Dos alternativas para responder.
                    </p>
                </div>

                <div>
                    <span>03</span>
                    <p>
                        <strong>Respuesta abierta</strong><br />
                        El estudiante escribe su respuesta.
                    </p>
                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
