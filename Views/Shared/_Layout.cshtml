@using Microsoft.AspNetCore.Identity
@using EcommerceApp.Models
@inject SignInManager<ApplicationUser> SignInManager

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - ExamSecure</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/examsecure.css"
          asp-append-version="true" />
</head>

<body>

    <div class="ambient ambient-one"></div>
    <div class="ambient ambient-two"></div>

    <header>
        <nav class="navbar navbar-expand-lg exam-navbar">
            <div class="container-fluid px-4">

                <a class="navbar-brand exam-brand" asp-controller="Home" asp-action="Index">
                    <span class="brand-mark">
                        <span>ES</span>
                    </span>

                    <span class="brand-text">
                        <strong>ExamSecure</strong>
                        <small>Control Académico</small>
                    </span>
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">

                    @if (SignInManager.IsSignedIn(User))
                    {
                        <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Home"
                                   asp-action="Index">
                                    <span>⌂</span>
                                    Inicio
                                </a>
                            </li>

                            @if (User.IsInRole("Administrador"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="Usuarios"
                                       asp-action="Index">
                                        <span>◉</span>
                                        Usuarios
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="Materias"
                                       asp-action="Index">
                                        <span>▦</span>
                                        Materias
                                    </a>
                                </li>
                            }

                            @if (User.IsInRole("Docente"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="Examenes"
                                       asp-action="Index">
                                        <span>▤</span>
                                        Exámenes
                                    </a>
                                </li>
                            }

                        </ul>

                        <div class="navbar-user-area">

                            <div class="navbar-user">
                                <div class="user-avatar">
                                    @(
                                        !string.IsNullOrWhiteSpace(User.Identity?.Name)
                                            ? User.Identity!.Name!.Substring(0, 1).ToUpper()
                                            : "U"
                                    )
                                </div>

                                <div class="user-info">
                                    <strong>
                                        @(User.Identity?.Name ?? "Usuario")
                                    </strong>

                                    <small>
                                        @if (User.IsInRole("Administrador"))
                                        {
                                            <span>Administrador</span>
                                        }
                                        else if (User.IsInRole("Docente"))
                                        {
                                            <span>Docente</span>
                                        }
                                        else if (User.IsInRole("Estudiante"))
                                        {
                                            <span>Estudiante</span>
                                        }
                                    </small>
                                </div>
                            </div>

                            <form asp-controller="Account"
                                  asp-action="Logout"
                                  method="post"
                                  class="logout-form">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="logout-button"
                                        title="Cerrar sesión">

                                    <span class="logout-icon">↪</span>
                                    <span>Cerrar sesión</span>
                                </button>
                            </form>

                        </div>
                    }

                </div>
            </div>
        </nav>
    </header>

    <main class="exam-main">
        <div class="container-fluid px-4">

            @if (TempData["Success"] != null)
            {
                <div class="exam-toast success-toast">
                    <span class="toast-icon">✓</span>
                    <span>@TempData["Success"]</span>
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="exam-toast error-toast">
                    <span class="toast-icon">!</span>
                    <span>@TempData["Error"]</span>
                </div>
            }

            @RenderBody()

        </div>
    </main>

    <footer class="exam-footer">
        <div>
            <strong>ExamSecure</strong>
            <span> · Plataforma de evaluación segura</span>
        </div>

        <div>
            © @DateTime.Now.Year
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/examsecure.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
