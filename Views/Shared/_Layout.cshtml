@using Microsoft.AspNetCore.Identity
@using EcommerceApp.Models
@inject SignInManager<ApplicationUser> SignInManager

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <meta name="theme-color" content="#080d18" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="ExamSecure" />

    <link rel="manifest" href="~/manifest.json" />

    <link rel="icon"
          type="image/svg+xml"
          href="~/icons/examsecure-logo.svg"
          asp-append-version="true" />

    <link rel="apple-touch-icon"
          href="~/icons/examsecure-logo.svg"
          asp-append-version="true" />

    <title>@ViewData["Title"] - ExamSecure</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/examsecure.css"
          asp-append-version="true" />
</head>

<body>

    <div class="ambient ambient-one"></div>
    <div class="ambient ambient-two"></div>

    <header class="exam-header">

        <nav class="navbar navbar-expand-lg exam-navbar">

            <div class="container-fluid px-4">

                <!-- BRAND -->
                <a class="navbar-brand exam-brand"
                   asp-controller="Home"
                   asp-action="Index">

                    <span class="brand-logo">
                        <img src="~/icons/examsecure-logo.svg"
                             alt="ExamSecure"
                             asp-append-version="true" />
                    </span>

                    <span class="brand-text">

                        <strong>ExamSecure</strong>

                        <small>
                            Evaluación académica segura
                        </small>

                    </span>

                </a>

                <!-- MOBILE BUTTON -->
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Abrir navegación">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <div class="collapse navbar-collapse"
                     id="mainNavbar">

                    @if (SignInManager.IsSignedIn(User))
                    {
                        <ul class="navbar-nav me-auto mb-2 mb-lg-0 exam-nav-links">

                            <!-- INICIO -->
                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Home"
                                   asp-action="Index">

                                    <svg viewBox="0 0 24 24"
                                         aria-hidden="true">

                                        <path d="M3 10.5L12 3l9 7.5" />
                                        <path d="M5 9.5V21h14V9.5" />
                                        <path d="M9 21v-6h6v6" />

                                    </svg>

                                    <span>Inicio</span>

                                </a>

                            </li>

                            <!-- ADMINISTRADOR -->
                            @if (User.IsInRole("Administrador"))
                            {
                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="Usuarios"
                                       asp-action="Index">

                                        <svg viewBox="0 0 24 24"
                                             aria-hidden="true">

                                            <circle cx="9" cy="8" r="3" />
                                            <path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6" />
                                            <path d="M16 11c2.8 0 5 2.2 5 5" />
                                            <path d="M16 5.5c1.7 0 3 1.3 3 3" />

                                        </svg>

                                        <span>Usuarios</span>

                                    </a>

                                </li>

                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="Materias"
                                       asp-action="Index">

                                        <svg viewBox="0 0 24 24"
                                             aria-hidden="true">

                                            <rect x="4" y="3" width="16" height="18" rx="2" />
                                            <path d="M8 7h8" />
                                            <path d="M8 11h8" />
                                            <path d="M8 15h5" />

                                        </svg>

                                        <span>Materias</span>

                                    </a>

                                </li>

                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="Reportes"
                                       asp-action="Index">

                                        <svg viewBox="0 0 24 24"
                                             aria-hidden="true">

                                            <path d="M4 20V10" />
                                            <path d="M10 20V4" />
                                            <path d="M16 20v-7" />
                                            <path d="M22 20H2" />

                                        </svg>

                                        <span>Reportes</span>

                                    </a>

                                </li>
                            }

                            <!-- DOCENTE -->
                            @if (User.IsInRole("Docente"))
                            {
                                <!-- MIS MATERIAS -->
                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="Docente"
                                       asp-action="MisMaterias">

                                        <svg viewBox="0 0 24 24"
                                             aria-hidden="true">

                                            <path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v15H6.5A2.5 2.5 0 0 0 4 20.5z" />
                                            <path d="M4 5.5v15" />
                                            <path d="M8 7h8" />
                                            <path d="M8 11h8" />

                                        </svg>

                                        <span>Mis materias</span>

                                    </a>

                                </li>

                                <!-- EXÁMENES -->
                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="Examenes"
                                       asp-action="Index">

                                        <svg viewBox="0 0 24 24"
                                             aria-hidden="true">

                                            <rect x="4" y="3" width="16" height="18" rx="2" />
                                            <path d="M8 8h8" />
                                            <path d="M8 12h8" />
                                            <path d="M8 16h5" />

                                        </svg>

                                        <span>Exámenes</span>

                                    </a>

                                </li>

                                <!-- RESULTADOS -->
                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="Docente"
                                       asp-action="Resultados">

                                        <svg viewBox="0 0 24 24"
                                             aria-hidden="true">

                                            <path d="M4 19V5" />
                                            <path d="M4 19h16" />
                                            <path d="m7 15 3-4 3 2 5-6" />

                                        </svg>

                                        <span>Resultados</span>

                                    </a>

                                </li>

                                <!-- REPORTES -->
                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="Reportes"
                                       asp-action="Index">

                                        <svg viewBox="0 0 24 24"
                                             aria-hidden="true">

                                            <path d="M4 20V10" />
                                            <path d="M10 20V4" />
                                            <path d="M16 20v-7" />
                                            <path d="M22 20H2" />

                                        </svg>

                                        <span>Reportes</span>

                                    </a>

                                </li>
                            }

                            <!-- ESTUDIANTE -->
                            @if (User.IsInRole("Estudiante"))
                            {
                                <!-- MIS MATERIAS -->
                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="Estudiante"
                                       asp-action="MisMaterias">

                                        <svg viewBox="0 0 24 24"
                                             aria-hidden="true">

                                            <path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v15H6.5A2.5 2.5 0 0 0 4 20.5z" />
                                            <path d="M4 5.5v15" />
                                            <path d="M8 7h8" />
                                            <path d="M8 11h8" />

                                        </svg>

                                        <span>Mis materias</span>

                                    </a>

                                </li>

                                <!-- MIS EXÁMENES -->
                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="Estudiante"
                                       asp-action="Index">

                                        <svg viewBox="0 0 24 24"
                                             aria-hidden="true">

                                            <path d="M4 6h16v12H4z" />
                                            <path d="M8 10h8" />
                                            <path d="M8 14h5" />

                                        </svg>

                                        <span>Mis exámenes</span>

                                    </a>

                                </li>

                                <!-- RESULTADOS -->
                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="Estudiante"
                                       asp-action="Resultados">

                                        <svg viewBox="0 0 24 24"
                                             aria-hidden="true">

                                            <path d="M4 19V5" />
                                            <path d="M4 19h16" />
                                            <path d="m7 15 3-4 3 2 5-6" />

                                        </svg>

                                        <span>Resultados</span>

                                    </a>

                                </li>
                            }

                        </ul>

                        <!-- USER AREA -->
                        <div class="navbar-user-area">

                            <div class="navbar-user">

                                <div class="user-avatar">

                                    @(
                                        !string.IsNullOrWhiteSpace(User.Identity?.Name)
                                            ? User.Identity!.Name!.Substring(0, 1).ToUpper()
                                            : "U"
                                    )

                                </div>

                                <div class="user-info">

                                    <strong>
                                        @(User.Identity?.Name ?? "Usuario")
                                    </strong>

                                    <small>

                                        @if (User.IsInRole("Administrador"))
                                        {
                                            <span>Administrador</span>
                                        }
                                        else if (User.IsInRole("Docente"))
                                        {
                                            <span>Docente</span>
                                        }
                                        else if (User.IsInRole("Estudiante"))
                                        {
                                            <span>Estudiante</span>
                                        }

                                    </small>

                                </div>

                            </div>

                            <!-- LOGOUT -->
                            <form asp-controller="Account"
                                  asp-action="Logout"
                                  method="post"
                                  class="logout-form">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="logout-button"
                                        title="Cerrar sesión">

                                    <svg viewBox="0 0 24 24"
                                         aria-hidden="true">

                                        <path d="M10 4H5v16h5" />
                                        <path d="M14 8l4 4-4 4" />
                                        <path d="M18 12H9" />

                                    </svg>

                                    <span>Cerrar sesión</span>

                                </button>

                            </form>

                        </div>
                    }

                </div>

            </div>

        </nav>

    </header>

    <main class="exam-main">

        <div class="container-fluid px-4">

            @if (TempData["Success"] != null)
            {
                <div class="exam-toast success-toast">

                    <span class="toast-icon">✓</span>

                    <span>
                        @TempData["Success"]
                    </span>

                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="exam-toast error-toast">

                    <span class="toast-icon">!</span>

                    <span>
                        @TempData["Error"]
                    </span>

                </div>
            }

            @RenderBody()

        </div>

    </main>

    <footer class="exam-footer">

        <div class="footer-brand">

            <img src="~/icons/examsecure-logo.svg"
                 alt=""
                 asp-append-version="true" />

            <div>

                <strong>ExamSecure</strong>

                <span>
                    Plataforma de evaluación segura
                </span>

            </div>

        </div>

        <div class="footer-copy">
            © @DateTime.Now.Year
        </div>

    </footer>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/examsecure.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

    <script>
        if ("serviceWorker" in navigator) {
            window.addEventListener("load", () => {
                navigator.serviceWorker
                    .register("/sw.js")
                    .catch(error => {
                        console.error(
                            "Error registrando Service Worker:",
                            error
                        );
                    });
            });
        }
    </script>

</body>
</html>


