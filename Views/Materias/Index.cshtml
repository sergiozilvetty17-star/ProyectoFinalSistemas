@model IEnumerable<EcommerceApp.Models.Materia>

@{
    ViewData["Title"] = "Materias";
    var docentes = ViewBag.Docentes;
}

<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <span class="badge bg-dark mb-2">EXAMSECURE</span>
            <h1 class="fw-bold mb-1">Materias</h1>
            <p class="text-muted mb-0">
                Administración de materias académicas.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-dark">
            + Nueva materia
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">

            @if (!Model.Any())
            {
                <div class="p-5 text-center">
                    <h4>No hay materias registradas</h4>
                    <p class="text-muted">
                        Crea la primera materia para comenzar.
                    </p>

                    <a asp-action="Create"
                       class="btn btn-dark">
                        Crear materia
                    </a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-dark">
                            <tr>
                                <th>Código</th>
                                <th>Materia</th>
                                <th>Docente</th>
                                <th>Estado</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var materia in Model)
                            {
                                <tr>
                                    <td>
                                        <span class="fw-bold">
                                            @materia.Codigo
                                        </span>
                                    </td>

                                    <td>
                                        <div class="fw-semibold">
                                            @materia.Nombre
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(
                                            materia.Descripcion))
                                        {
                                            <small class="text-muted">
                                                @materia.Descripcion
                                            </small>
                                        }
                                    </td>

                                    <td>
                                        @if (materia.Docente?.Usuario != null)
                                        {
                                            @materia.Docente.Usuario.NombreCompleto
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Sin asignar
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @if (materia.Activa)
                                        {
                                            <span class="badge bg-success">
                                                Activa
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Inactiva
                                            </span>
                                        }
                                    </td>

                                    <td class="text-end">

                                        <a asp-action="Edit"
                                           asp-route-id="@materia.Id"
                                           class="btn btn-sm btn-outline-dark">
                                            Editar
                                        </a>

                                        <form asp-action="ToggleEstado"
                                              asp-route-id="@materia.Id"
                                              method="post"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm @(materia.Activa
                                                        ? "btn-outline-danger"
                                                        : "btn-outline-success")">
                                                @(materia.Activa
                                                    ? "Desactivar"
                                                    : "Activar")
                                            </button>

                                        </form>

                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>
            }

        </div>
    </div>

</div>
